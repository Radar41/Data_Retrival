digraph graph_physical {
graph [rankdir=LR, compound=true, splines=spline, nodesep=0.35, ranksep=1.0, pad=0.4, fontname="Helvetica", labelloc=t, fontsize=20, label=<<B>FRED Metadata Catalog: Neo4j Physical Design: Neo4j Community 2026.07</B><BR/><FONT POINT-SIZE="11">Adrian Aziza · ADIT2200-01 Database Management, Fall 2026</FONT>>];
node [shape=plaintext, fontname="Helvetica", fontsize=10];
edge [color="#1f3557", fontname="Helvetica", fontsize=9, arrowsize=0.8, fontcolor="#333333"];
subgraph cluster_catalog {
label=<<B>FRED catalog (from the relational model)</B>>; fontsize=13; style="rounded,filled"; fillcolor="#e8eef7"; color="#9aa7b8";
"Source" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" STYLE="ROUNDED" BGCOLOR="white" COLOR="#1f3557"><TR><TD COLSPAN="3" BGCOLOR="#1f3557" CELLPADDING="5"><FONT COLOR="white" POINT-SIZE="12"><B>:Source</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><U><B>source_key</B></U></TD><TD ALIGN="LEFT"><FONT COLOR="#1f5537">STRING</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">required</FONT></TD></TR><TR><TD ALIGN="LEFT">source_id</TD><TD ALIGN="LEFT"><FONT COLOR="#1f5537">INTEGER</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">required</FONT></TD></TR><TR><TD ALIGN="LEFT">provider_id</TD><TD ALIGN="LEFT"><FONT COLOR="#1f5537">STRING</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">required</FONT></TD></TR><TR><TD ALIGN="LEFT">name</TD><TD ALIGN="LEFT"><FONT COLOR="#1f5537">STRING</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">required</FONT></TD></TR><TR><TD ALIGN="LEFT">link</TD><TD ALIGN="LEFT"><FONT COLOR="#1f5537">STRING</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">optional</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="#eef2f8"><FONT POINT-SIZE="8">CONSTRAINT source_key_unique UNIQUE (source_key)</FONT></TD></TR></TABLE>>];
"Release" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" STYLE="ROUNDED" BGCOLOR="white" COLOR="#1f3557"><TR><TD COLSPAN="3" BGCOLOR="#1f3557" CELLPADDING="5"><FONT COLOR="white" POINT-SIZE="12"><B>:Release</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><U><B>release_key</B></U></TD><TD ALIGN="LEFT"><FONT COLOR="#1f5537">STRING</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">required</FONT></TD></TR><TR><TD ALIGN="LEFT">release_id</TD><TD ALIGN="LEFT"><FONT COLOR="#1f5537">INTEGER</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">required</FONT></TD></TR><TR><TD ALIGN="LEFT">provider_id</TD><TD ALIGN="LEFT"><FONT COLOR="#1f5537">STRING</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">required</FONT></TD></TR><TR><TD ALIGN="LEFT">name</TD><TD ALIGN="LEFT"><FONT COLOR="#1f5537">STRING</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">required</FONT></TD></TR><TR><TD ALIGN="LEFT">press_release</TD><TD ALIGN="LEFT"><FONT COLOR="#1f5537">BOOLEAN</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">required</FONT></TD></TR><TR><TD ALIGN="LEFT">link</TD><TD ALIGN="LEFT"><FONT COLOR="#1f5537">STRING</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">optional</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="#eef2f8"><FONT POINT-SIZE="8">CONSTRAINT release_key_unique UNIQUE (release_key)</FONT></TD></TR></TABLE>>];
"ReleaseDate" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" STYLE="ROUNDED" BGCOLOR="white" COLOR="#1f3557"><TR><TD COLSPAN="3" BGCOLOR="#1f3557" CELLPADDING="5"><FONT COLOR="white" POINT-SIZE="12"><B>:ReleaseDate</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><U><B>rd_key</B></U></TD><TD ALIGN="LEFT"><FONT COLOR="#1f5537">STRING</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">required</FONT></TD></TR><TR><TD ALIGN="LEFT">release_key</TD><TD ALIGN="LEFT"><FONT COLOR="#1f5537">STRING</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">required</FONT></TD></TR><TR><TD ALIGN="LEFT">date</TD><TD ALIGN="LEFT"><FONT COLOR="#1f5537">DATE</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">required</FONT></TD></TR><TR><TD ALIGN="LEFT">status</TD><TD ALIGN="LEFT"><FONT COLOR="#1f5537">STRING</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">required</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="#eef2f8"><FONT POINT-SIZE="8">CONSTRAINT release_date_key UNIQUE (rd_key)<BR/>RANGE INDEX release_date_date (date)</FONT></TD></TR></TABLE>>];
"ReleaseTableElement" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" STYLE="ROUNDED" BGCOLOR="white" COLOR="#1f3557"><TR><TD COLSPAN="3" BGCOLOR="#1f3557" CELLPADDING="5"><FONT COLOR="white" POINT-SIZE="12"><B>:ReleaseTableElement</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><U><B>element_key</B></U></TD><TD ALIGN="LEFT"><FONT COLOR="#1f5537">STRING</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">required</FONT></TD></TR><TR><TD ALIGN="LEFT">element_id</TD><TD ALIGN="LEFT"><FONT COLOR="#1f5537">INTEGER</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">required</FONT></TD></TR><TR><TD ALIGN="LEFT">release_key</TD><TD ALIGN="LEFT"><FONT COLOR="#1f5537">STRING</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">required</FONT></TD></TR><TR><TD ALIGN="LEFT">parent_key</TD><TD ALIGN="LEFT"><FONT COLOR="#1f5537">STRING</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">optional</FONT></TD></TR><TR><TD ALIGN="LEFT">type</TD><TD ALIGN="LEFT"><FONT COLOR="#1f5537">STRING</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">required</FONT></TD></TR><TR><TD ALIGN="LEFT">name</TD><TD ALIGN="LEFT"><FONT COLOR="#1f5537">STRING</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">required</FONT></TD></TR><TR><TD ALIGN="LEFT">level</TD><TD ALIGN="LEFT"><FONT COLOR="#1f5537">INTEGER</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">required</FONT></TD></TR><TR><TD ALIGN="LEFT">line</TD><TD ALIGN="LEFT"><FONT COLOR="#1f5537">INTEGER</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">optional</FONT></TD></TR><TR><TD ALIGN="LEFT">series_id</TD><TD ALIGN="LEFT"><FONT COLOR="#1f5537">STRING</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">optional</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="#eef2f8"><FONT POINT-SIZE="8">CONSTRAINT release_table_element_key_unique UNIQUE (element_key)<BR/>RANGE INDEX release_table_element_series (series_id)</FONT></TD></TR></TABLE>>];
"Frequency" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" STYLE="ROUNDED" BGCOLOR="white" COLOR="#1f3557"><TR><TD COLSPAN="3" BGCOLOR="#1f3557" CELLPADDING="5"><FONT COLOR="white" POINT-SIZE="12"><B>:Frequency</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><U><B>code</B></U></TD><TD ALIGN="LEFT"><FONT COLOR="#1f5537">STRING</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">required</FONT></TD></TR><TR><TD ALIGN="LEFT">name</TD><TD ALIGN="LEFT"><FONT COLOR="#1f5537">STRING</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">required</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="#eef2f8"><FONT POINT-SIZE="8">CONSTRAINT frequency_code_unique UNIQUE (code)</FONT></TD></TR></TABLE>>];
"Units" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" STYLE="ROUNDED" BGCOLOR="white" COLOR="#1f3557"><TR><TD COLSPAN="3" BGCOLOR="#1f3557" CELLPADDING="5"><FONT COLOR="white" POINT-SIZE="12"><B>:Units</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><U><B>code</B></U></TD><TD ALIGN="LEFT"><FONT COLOR="#1f5537">STRING</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">required</FONT></TD></TR><TR><TD ALIGN="LEFT">name</TD><TD ALIGN="LEFT"><FONT COLOR="#1f5537">STRING</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">required</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="#eef2f8"><FONT POINT-SIZE="8">CONSTRAINT units_code_unique UNIQUE (code)</FONT></TD></TR></TABLE>>];
"SeasonalAdjustment" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" STYLE="ROUNDED" BGCOLOR="white" COLOR="#1f3557"><TR><TD COLSPAN="3" BGCOLOR="#1f3557" CELLPADDING="5"><FONT COLOR="white" POINT-SIZE="12"><B>:SeasonalAdjustment</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><U><B>code</B></U></TD><TD ALIGN="LEFT"><FONT COLOR="#1f5537">STRING</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">required</FONT></TD></TR><TR><TD ALIGN="LEFT">name</TD><TD ALIGN="LEFT"><FONT COLOR="#1f5537">STRING</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">required</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="#eef2f8"><FONT POINT-SIZE="8">CONSTRAINT sa_code_unique UNIQUE (code)</FONT></TD></TR></TABLE>>];
"Category" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" STYLE="ROUNDED" BGCOLOR="white" COLOR="#1f3557"><TR><TD COLSPAN="3" BGCOLOR="#1f3557" CELLPADDING="5"><FONT COLOR="white" POINT-SIZE="12"><B>:Category</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><U><B>provider_id</B></U></TD><TD ALIGN="LEFT"><FONT COLOR="#1f5537">STRING</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">required</FONT></TD></TR><TR><TD ALIGN="LEFT"><U><B>category_id</B></U></TD><TD ALIGN="LEFT"><FONT COLOR="#1f5537">STRING</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">required</FONT></TD></TR><TR><TD ALIGN="LEFT">category_key</TD><TD ALIGN="LEFT"><FONT COLOR="#1f5537">STRING</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">required</FONT></TD></TR><TR><TD ALIGN="LEFT">name</TD><TD ALIGN="LEFT"><FONT COLOR="#1f5537">STRING</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">required</FONT></TD></TR><TR><TD ALIGN="LEFT">parent_id</TD><TD ALIGN="LEFT"><FONT COLOR="#1f5537">STRING</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">required</FONT></TD></TR><TR><TD ALIGN="LEFT">is_root</TD><TD ALIGN="LEFT"><FONT COLOR="#1f5537">BOOLEAN</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">required</FONT></TD></TR><TR><TD ALIGN="LEFT">catalog_source</TD><TD ALIGN="LEFT"><FONT COLOR="#1f5537">STRING</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">optional</FONT></TD></TR><TR><TD ALIGN="LEFT">import_file</TD><TD ALIGN="LEFT"><FONT COLOR="#1f5537">STRING</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">optional</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="#eef2f8"><FONT POINT-SIZE="8">CONSTRAINT category_key_unique UNIQUE (provider_id, category_id)</FONT></TD></TR></TABLE>>];
"TagGroup" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" STYLE="ROUNDED" BGCOLOR="white" COLOR="#1f3557"><TR><TD COLSPAN="3" BGCOLOR="#1f3557" CELLPADDING="5"><FONT COLOR="white" POINT-SIZE="12"><B>:TagGroup</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><U><B>group_id</B></U></TD><TD ALIGN="LEFT"><FONT COLOR="#1f5537">STRING</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">required</FONT></TD></TR><TR><TD ALIGN="LEFT">name</TD><TD ALIGN="LEFT"><FONT COLOR="#1f5537">STRING</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">required</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="#eef2f8"><FONT POINT-SIZE="8">CONSTRAINT tag_group_id_unique UNIQUE (group_id)</FONT></TD></TR></TABLE>>];
"Tag" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" STYLE="ROUNDED" BGCOLOR="white" COLOR="#1f3557"><TR><TD COLSPAN="3" BGCOLOR="#1f3557" CELLPADDING="5"><FONT COLOR="white" POINT-SIZE="12"><B>:Tag</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><U><B>tag_name</B></U></TD><TD ALIGN="LEFT"><FONT COLOR="#1f5537">STRING</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">required</FONT></TD></TR><TR><TD ALIGN="LEFT">notes</TD><TD ALIGN="LEFT"><FONT COLOR="#1f5537">STRING</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">optional</FONT></TD></TR><TR><TD ALIGN="LEFT">popularity</TD><TD ALIGN="LEFT"><FONT COLOR="#1f5537">INTEGER</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">required</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="#eef2f8"><FONT POINT-SIZE="8">CONSTRAINT tag_name_unique UNIQUE (tag_name)</FONT></TD></TR></TABLE>>];
"Series" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" STYLE="ROUNDED" BGCOLOR="white" COLOR="#1f3557"><TR><TD COLSPAN="3" BGCOLOR="#1f3557" CELLPADDING="5"><FONT COLOR="white" POINT-SIZE="12"><B>:Series</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><U><B>catalog_key</B></U></TD><TD ALIGN="LEFT"><FONT COLOR="#1f5537">STRING</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">required</FONT></TD></TR><TR><TD ALIGN="LEFT">series_id</TD><TD ALIGN="LEFT"><FONT COLOR="#1f5537">STRING</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">required</FONT></TD></TR><TR><TD ALIGN="LEFT">title</TD><TD ALIGN="LEFT"><FONT COLOR="#1f5537">STRING</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">required</FONT></TD></TR><TR><TD ALIGN="LEFT">observation_start</TD><TD ALIGN="LEFT"><FONT COLOR="#1f5537">DATE</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">optional</FONT></TD></TR><TR><TD ALIGN="LEFT">observation_end</TD><TD ALIGN="LEFT"><FONT COLOR="#1f5537">DATE</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">optional</FONT></TD></TR><TR><TD ALIGN="LEFT">last_updated</TD><TD ALIGN="LEFT"><FONT COLOR="#1f5537">ZONED DATETIME</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">optional</FONT></TD></TR><TR><TD ALIGN="LEFT">popularity</TD><TD ALIGN="LEFT"><FONT COLOR="#1f5537">INTEGER</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">optional</FONT></TD></TR><TR><TD ALIGN="LEFT">notes</TD><TD ALIGN="LEFT"><FONT COLOR="#1f5537">STRING</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">optional</FONT></TD></TR><TR><TD ALIGN="LEFT">series_catalog_key</TD><TD ALIGN="LEFT"><FONT COLOR="#1f5537">STRING</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">optional</FONT></TD></TR><TR><TD ALIGN="LEFT">provider_id</TD><TD ALIGN="LEFT"><FONT COLOR="#1f5537">STRING</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">optional</FONT></TD></TR><TR><TD ALIGN="LEFT">dataset_id</TD><TD ALIGN="LEFT"><FONT COLOR="#1f5537">STRING</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">optional</FONT></TD></TR><TR><TD ALIGN="LEFT">source_datalist_id</TD><TD ALIGN="LEFT"><FONT COLOR="#1f5537">STRING</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">optional</FONT></TD></TR><TR><TD ALIGN="LEFT">raw_archive_sha256</TD><TD ALIGN="LEFT"><FONT COLOR="#1f5537">STRING</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">optional</FONT></TD></TR><TR><TD ALIGN="LEFT">frequency</TD><TD ALIGN="LEFT"><FONT COLOR="#1f5537">STRING</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">optional</FONT></TD></TR><TR><TD ALIGN="LEFT">seasonal_adjustment</TD><TD ALIGN="LEFT"><FONT COLOR="#1f5537">STRING</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">optional</FONT></TD></TR><TR><TD ALIGN="LEFT">units_level</TD><TD ALIGN="LEFT"><FONT COLOR="#1f5537">STRING</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">optional</FONT></TD></TR><TR><TD ALIGN="LEFT">release</TD><TD ALIGN="LEFT"><FONT COLOR="#1f5537">STRING</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">optional</FONT></TD></TR><TR><TD ALIGN="LEFT">source</TD><TD ALIGN="LEFT"><FONT COLOR="#1f5537">STRING</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">optional</FONT></TD></TR><TR><TD ALIGN="LEFT">real_time_start</TD><TD ALIGN="LEFT"><FONT COLOR="#1f5537">STRING</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">optional</FONT></TD></TR><TR><TD ALIGN="LEFT">period_end</TD><TD ALIGN="LEFT"><FONT COLOR="#1f5537">STRING</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">optional</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="#eef2f8"><FONT POINT-SIZE="8">CONSTRAINT fred_series_catalog_key_unique UNIQUE (catalog_key)<BR/>RANGE INDEX series_id_lookup (series_id)<BR/>RANGE INDEX series_last_updated (last_updated)</FONT></TD></TR></TABLE>>];
}
subgraph cluster_documents {
label=<<B>Press releases (unstructured)</B>>; fontsize=13; style="rounded,filled"; fillcolor="#eef6ea"; color="#9aa7b8";
"Document" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" STYLE="ROUNDED" BGCOLOR="white" COLOR="#1f3557"><TR><TD COLSPAN="3" BGCOLOR="#1f3557" CELLPADDING="5"><FONT COLOR="white" POINT-SIZE="12"><B>:Document</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><U><B>doc_id</B></U></TD><TD ALIGN="LEFT"><FONT COLOR="#1f5537">STRING</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">required</FONT></TD></TR><TR><TD ALIGN="LEFT">release_key</TD><TD ALIGN="LEFT"><FONT COLOR="#1f5537">STRING</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">required</FONT></TD></TR><TR><TD ALIGN="LEFT">release_date</TD><TD ALIGN="LEFT"><FONT COLOR="#1f5537">DATE</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">required</FONT></TD></TR><TR><TD ALIGN="LEFT">title</TD><TD ALIGN="LEFT"><FONT COLOR="#1f5537">STRING</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">required</FONT></TD></TR><TR><TD ALIGN="LEFT">source_name</TD><TD ALIGN="LEFT"><FONT COLOR="#1f5537">STRING</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">required</FONT></TD></TR><TR><TD ALIGN="LEFT">file_type</TD><TD ALIGN="LEFT"><FONT COLOR="#1f5537">STRING</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">required</FONT></TD></TR><TR><TD ALIGN="LEFT">path</TD><TD ALIGN="LEFT"><FONT COLOR="#1f5537">STRING</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">required</FONT></TD></TR><TR><TD ALIGN="LEFT">sha256</TD><TD ALIGN="LEFT"><FONT COLOR="#1f5537">STRING</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">required</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="#eef2f8"><FONT POINT-SIZE="8">CONSTRAINT document_id_unique UNIQUE (doc_id)</FONT></TD></TR></TABLE>>];
"Chunk" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" STYLE="ROUNDED" BGCOLOR="white" COLOR="#1f3557"><TR><TD COLSPAN="3" BGCOLOR="#1f3557" CELLPADDING="5"><FONT COLOR="white" POINT-SIZE="12"><B>:Chunk</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><U><B>chunk_key</B></U></TD><TD ALIGN="LEFT"><FONT COLOR="#1f5537">STRING</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">required</FONT></TD></TR><TR><TD ALIGN="LEFT">doc_id</TD><TD ALIGN="LEFT"><FONT COLOR="#1f5537">STRING</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">required</FONT></TD></TR><TR><TD ALIGN="LEFT">seq</TD><TD ALIGN="LEFT"><FONT COLOR="#1f5537">INTEGER</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">required</FONT></TD></TR><TR><TD ALIGN="LEFT">text</TD><TD ALIGN="LEFT"><FONT COLOR="#1f5537">STRING</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">required</FONT></TD></TR><TR><TD ALIGN="LEFT">embedding</TD><TD ALIGN="LEFT"><FONT COLOR="#1f5537">LIST&lt;FLOAT&gt;</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">required</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="#eef2f8"><FONT POINT-SIZE="8">CONSTRAINT chunk_key UNIQUE (chunk_key)<BR/>FULLTEXT INDEX chunk_text (text) analyzer standard-no-stop-words<BR/>VECTOR INDEX chunk_embedding (embedding) 768 dims, COSINE, HNSW m=16</FONT></TD></TR></TABLE>>];
}
subgraph cluster_lineage {
label=<<B>Provenance and lineage</B>>; fontsize=13; style="rounded,filled"; fillcolor="#f6f0e6"; color="#9aa7b8";
"Provider" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" STYLE="ROUNDED" BGCOLOR="white" COLOR="#1f3557"><TR><TD COLSPAN="3" BGCOLOR="#1f3557" CELLPADDING="5"><FONT COLOR="white" POINT-SIZE="12"><B>:Provider</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><U><B>provider_id</B></U></TD><TD ALIGN="LEFT"><FONT COLOR="#1f5537">STRING</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">required</FONT></TD></TR><TR><TD ALIGN="LEFT">name</TD><TD ALIGN="LEFT"><FONT COLOR="#1f5537">STRING</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">required</FONT></TD></TR><TR><TD ALIGN="LEFT">short_name</TD><TD ALIGN="LEFT"><FONT COLOR="#1f5537">STRING</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">required</FONT></TD></TR><TR><TD ALIGN="LEFT">display_name</TD><TD ALIGN="LEFT"><FONT COLOR="#1f5537">STRING</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">required</FONT></TD></TR><TR><TD ALIGN="LEFT">description</TD><TD ALIGN="LEFT"><FONT COLOR="#1f5537">STRING</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">required</FONT></TD></TR><TR><TD ALIGN="LEFT">project</TD><TD ALIGN="LEFT"><FONT COLOR="#1f5537">STRING</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">required</FONT></TD></TR><TR><TD ALIGN="LEFT">api_base_url</TD><TD ALIGN="LEFT"><FONT COLOR="#1f5537">STRING</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">required</FONT></TD></TR><TR><TD ALIGN="LEFT">homepage_url</TD><TD ALIGN="LEFT"><FONT COLOR="#1f5537">STRING</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">required</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="#eef2f8"><FONT POINT-SIZE="8">CONSTRAINT provider_id_unique UNIQUE (provider_id)</FONT></TD></TR></TABLE>>];
"CatalogSnapshot" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" STYLE="ROUNDED" BGCOLOR="white" COLOR="#1f3557"><TR><TD COLSPAN="3" BGCOLOR="#1f3557" CELLPADDING="5"><FONT COLOR="white" POINT-SIZE="12"><B>:CatalogSnapshot</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><U><B>snapshot_id</B></U></TD><TD ALIGN="LEFT"><FONT COLOR="#1f5537">STRING</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">required</FONT></TD></TR><TR><TD ALIGN="LEFT">provider_id</TD><TD ALIGN="LEFT"><FONT COLOR="#1f5537">STRING</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">required</FONT></TD></TR><TR><TD ALIGN="LEFT">endpoint</TD><TD ALIGN="LEFT"><FONT COLOR="#1f5537">STRING</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">required</FONT></TD></TR><TR><TD ALIGN="LEFT">schema_version</TD><TD ALIGN="LEFT"><FONT COLOR="#1f5537">STRING</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">required</FONT></TD></TR><TR><TD ALIGN="LEFT">retrieved_at_utc</TD><TD ALIGN="LEFT"><FONT COLOR="#1f5537">STRING</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">optional</FONT></TD></TR><TR><TD ALIGN="LEFT">request_parameters</TD><TD ALIGN="LEFT"><FONT COLOR="#1f5537">STRING</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">optional</FONT></TD></TR><TR><TD ALIGN="LEFT">category_count</TD><TD ALIGN="LEFT"><FONT COLOR="#1f5537">INTEGER</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">optional</FONT></TD></TR><TR><TD ALIGN="LEFT">snapshot_directory</TD><TD ALIGN="LEFT"><FONT COLOR="#1f5537">STRING</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">optional</FONT></TD></TR><TR><TD ALIGN="LEFT">manifest_file</TD><TD ALIGN="LEFT"><FONT COLOR="#1f5537">STRING</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">optional</FONT></TD></TR><TR><TD ALIGN="LEFT">normalized_categories_file</TD><TD ALIGN="LEFT"><FONT COLOR="#1f5537">STRING</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">optional</FONT></TD></TR><TR><TD ALIGN="LEFT">neo4j_import_file</TD><TD ALIGN="LEFT"><FONT COLOR="#1f5537">STRING</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">optional</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="#eef2f8"><FONT POINT-SIZE="8">CONSTRAINT catalog_snapshot_id_unique UNIQUE (snapshot_id)</FONT></TD></TR></TABLE>>];
"ApiResponseArtifact" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" STYLE="ROUNDED" BGCOLOR="white" COLOR="#1f3557"><TR><TD COLSPAN="3" BGCOLOR="#1f3557" CELLPADDING="5"><FONT COLOR="white" POINT-SIZE="12"><B>:ApiResponseArtifact</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><U><B>path</B></U></TD><TD ALIGN="LEFT"><FONT COLOR="#1f5537">STRING</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">required</FONT></TD></TR><TR><TD ALIGN="LEFT">provider_id</TD><TD ALIGN="LEFT"><FONT COLOR="#1f5537">STRING</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">required</FONT></TD></TR><TR><TD ALIGN="LEFT">snapshot_id</TD><TD ALIGN="LEFT"><FONT COLOR="#1f5537">STRING</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">required</FONT></TD></TR><TR><TD ALIGN="LEFT">endpoint</TD><TD ALIGN="LEFT"><FONT COLOR="#1f5537">STRING</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">required</FONT></TD></TR><TR><TD ALIGN="LEFT">format</TD><TD ALIGN="LEFT"><FONT COLOR="#1f5537">STRING</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">required</FONT></TD></TR><TR><TD ALIGN="LEFT">kind</TD><TD ALIGN="LEFT"><FONT COLOR="#1f5537">STRING</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">required</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="#eef2f8"><FONT POINT-SIZE="8">CONSTRAINT api_response_artifact_path_unique UNIQUE (path)</FONT></TD></TR></TABLE>>];
"Dataset" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" STYLE="ROUNDED" BGCOLOR="white" COLOR="#1f3557"><TR><TD COLSPAN="3" BGCOLOR="#1f3557" CELLPADDING="5"><FONT COLOR="white" POINT-SIZE="12"><B>:Dataset</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><U><B>dataset_id</B></U></TD><TD ALIGN="LEFT"><FONT COLOR="#1f5537">STRING</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">required</FONT></TD></TR><TR><TD ALIGN="LEFT">title</TD><TD ALIGN="LEFT"><FONT COLOR="#1f5537">STRING</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">required</FONT></TD></TR><TR><TD ALIGN="LEFT">source_datalist_id</TD><TD ALIGN="LEFT"><FONT COLOR="#1f5537">STRING</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">required</FONT></TD></TR><TR><TD ALIGN="LEFT">source_url</TD><TD ALIGN="LEFT"><FONT COLOR="#1f5537">STRING</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">required</FONT></TD></TR><TR><TD ALIGN="LEFT">ingestion_status</TD><TD ALIGN="LEFT"><FONT COLOR="#1f5537">STRING</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">required</FONT></TD></TR><TR><TD ALIGN="LEFT">audit_status</TD><TD ALIGN="LEFT"><FONT COLOR="#1f5537">STRING</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">required</FONT></TD></TR><TR><TD ALIGN="LEFT">audit_at_utc</TD><TD ALIGN="LEFT"><FONT COLOR="#1f5537">STRING</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">required</FONT></TD></TR><TR><TD ALIGN="LEFT">metadata_series_count</TD><TD ALIGN="LEFT"><FONT COLOR="#1f5537">INTEGER</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">required</FONT></TD></TR><TR><TD ALIGN="LEFT">normalized_series_count</TD><TD ALIGN="LEFT"><FONT COLOR="#1f5537">INTEGER</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">required</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="#eef2f8"><FONT POINT-SIZE="8">CONSTRAINT dataset_id_unique UNIQUE (dataset_id)</FONT></TD></TR></TABLE>>];
"RawArtifact" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" STYLE="ROUNDED" BGCOLOR="white" COLOR="#1f3557"><TR><TD COLSPAN="3" BGCOLOR="#1f3557" CELLPADDING="5"><FONT COLOR="white" POINT-SIZE="12"><B>:RawArtifact</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><U><B>sha256</B></U></TD><TD ALIGN="LEFT"><FONT COLOR="#1f5537">STRING</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">required</FONT></TD></TR><TR><TD ALIGN="LEFT">provider_id</TD><TD ALIGN="LEFT"><FONT COLOR="#1f5537">STRING</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">required</FONT></TD></TR><TR><TD ALIGN="LEFT">original_file_name</TD><TD ALIGN="LEFT"><FONT COLOR="#1f5537">STRING</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">required</FONT></TD></TR><TR><TD ALIGN="LEFT">raw_file_name</TD><TD ALIGN="LEFT"><FONT COLOR="#1f5537">STRING</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">required</FONT></TD></TR><TR><TD ALIGN="LEFT">raw_file_path</TD><TD ALIGN="LEFT"><FONT COLOR="#1f5537">STRING</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">required</FONT></TD></TR><TR><TD ALIGN="LEFT">bytes</TD><TD ALIGN="LEFT"><FONT COLOR="#1f5537">INTEGER</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">required</FONT></TD></TR><TR><TD ALIGN="LEFT">storage_class</TD><TD ALIGN="LEFT"><FONT COLOR="#1f5537">STRING</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">required</FONT></TD></TR><TR><TD ALIGN="LEFT">registered_at_utc</TD><TD ALIGN="LEFT"><FONT COLOR="#1f5537">STRING</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">required</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="#eef2f8"><FONT POINT-SIZE="8">CONSTRAINT raw_artifact_sha256_unique UNIQUE (sha256)</FONT></TD></TR></TABLE>>];
"StagingRun" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" STYLE="ROUNDED" BGCOLOR="white" COLOR="#1f3557"><TR><TD COLSPAN="3" BGCOLOR="#1f3557" CELLPADDING="5"><FONT COLOR="white" POINT-SIZE="12"><B>:StagingRun</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><U><B>staging_key</B></U></TD><TD ALIGN="LEFT"><FONT COLOR="#1f5537">STRING</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">required</FONT></TD></TR><TR><TD ALIGN="LEFT">staging_path</TD><TD ALIGN="LEFT"><FONT COLOR="#1f5537">STRING</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">required</FONT></TD></TR><TR><TD ALIGN="LEFT">raw_archive_sha256</TD><TD ALIGN="LEFT"><FONT COLOR="#1f5537">STRING</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">required</FONT></TD></TR><TR><TD ALIGN="LEFT">normalization_status</TD><TD ALIGN="LEFT"><FONT COLOR="#1f5537">STRING</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">required</FONT></TD></TR><TR><TD ALIGN="LEFT">audit_status</TD><TD ALIGN="LEFT"><FONT COLOR="#1f5537">STRING</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">required</FONT></TD></TR><TR><TD ALIGN="LEFT">audit_at_utc</TD><TD ALIGN="LEFT"><FONT COLOR="#1f5537">STRING</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">required</FONT></TD></TR><TR><TD ALIGN="LEFT">metadata_series_count</TD><TD ALIGN="LEFT"><FONT COLOR="#1f5537">INTEGER</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">required</FONT></TD></TR><TR><TD ALIGN="LEFT">normalized_union_series_count</TD><TD ALIGN="LEFT"><FONT COLOR="#1f5537">INTEGER</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">required</FONT></TD></TR><TR><TD ALIGN="LEFT">weekly_normalized_rows</TD><TD ALIGN="LEFT"><FONT COLOR="#1f5537">INTEGER</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">required</FONT></TD></TR><TR><TD ALIGN="LEFT">ending_wednesday_normalized_rows</TD><TD ALIGN="LEFT"><FONT COLOR="#1f5537">INTEGER</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">required</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="#eef2f8"><FONT POINT-SIZE="8">no constraint (staging_key not enforced unique)</FONT></TD></TR></TABLE>>];
"SourceMember" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" STYLE="ROUNDED" BGCOLOR="white" COLOR="#1f3557"><TR><TD COLSPAN="3" BGCOLOR="#1f3557" CELLPADDING="5"><FONT COLOR="white" POINT-SIZE="12"><B>:SourceMember</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><U><B>member_key</B></U></TD><TD ALIGN="LEFT"><FONT COLOR="#1f5537">STRING</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">required</FONT></TD></TR><TR><TD ALIGN="LEFT">dataset_id</TD><TD ALIGN="LEFT"><FONT COLOR="#1f5537">STRING</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">required</FONT></TD></TR><TR><TD ALIGN="LEFT">member_path</TD><TD ALIGN="LEFT"><FONT COLOR="#1f5537">STRING</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">required</FONT></TD></TR><TR><TD ALIGN="LEFT">frequency_label</TD><TD ALIGN="LEFT"><FONT COLOR="#1f5537">STRING</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">required</FONT></TD></TR><TR><TD ALIGN="LEFT">base_series_count</TD><TD ALIGN="LEFT"><FONT COLOR="#1f5537">INTEGER</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">required</FONT></TD></TR><TR><TD ALIGN="LEFT">data_column_count</TD><TD ALIGN="LEFT"><FONT COLOR="#1f5537">INTEGER</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">required</FONT></TD></TR><TR><TD ALIGN="LEFT">normalized_row_count</TD><TD ALIGN="LEFT"><FONT COLOR="#1f5537">INTEGER</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">required</FONT></TD></TR><TR><TD ALIGN="LEFT">nonmissing_value_count</TD><TD ALIGN="LEFT"><FONT COLOR="#1f5537">INTEGER</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">required</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="#eef2f8"><FONT POINT-SIZE="8">CONSTRAINT source_member_key_unique UNIQUE (member_key)</FONT></TD></TR></TABLE>>];
"SeriesVariant" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" STYLE="ROUNDED" BGCOLOR="white" COLOR="#1f3557"><TR><TD COLSPAN="3" BGCOLOR="#1f3557" CELLPADDING="5"><FONT COLOR="white" POINT-SIZE="12"><B>:SeriesVariant</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><U><B>variant_key</B></U></TD><TD ALIGN="LEFT"><FONT COLOR="#1f5537">STRING</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">required</FONT></TD></TR><TR><TD ALIGN="LEFT">series_id</TD><TD ALIGN="LEFT"><FONT COLOR="#1f5537">STRING</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">required</FONT></TD></TR><TR><TD ALIGN="LEFT">dataset_id</TD><TD ALIGN="LEFT"><FONT COLOR="#1f5537">STRING</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">required</FONT></TD></TR><TR><TD ALIGN="LEFT">transformation_code</TD><TD ALIGN="LEFT"><FONT COLOR="#1f5537">STRING</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">required</FONT></TD></TR><TR><TD ALIGN="LEFT">frequency_label</TD><TD ALIGN="LEFT"><FONT COLOR="#1f5537">STRING</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">required</FONT></TD></TR><TR><TD ALIGN="LEFT">raw_column_name</TD><TD ALIGN="LEFT"><FONT COLOR="#1f5537">STRING</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">required</FONT></TD></TR><TR><TD ALIGN="LEFT">source_member_path</TD><TD ALIGN="LEFT"><FONT COLOR="#1f5537">STRING</FONT></TD><TD ALIGN="LEFT"><FONT POINT-SIZE="8">required</FONT></TD></TR><TR><TD COLSPAN="3" ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="#eef2f8"><FONT POINT-SIZE="8">CONSTRAINT series_variant_key_unique UNIQUE (variant_key)</FONT></TD></TR></TABLE>>];
}
"Series" -> "Release" [label=<<B>:IN_RELEASE</B>>, style=solid, constraint=true];
"Series" -> "Frequency" [label=<<B>:HAS_FREQUENCY</B>>, style=solid, constraint=true];
"Series" -> "Units" [label=<<B>:MEASURED_IN</B>>, style=solid, constraint=true];
"Series" -> "SeasonalAdjustment" [label=<<B>:ADJUSTED</B>>, style=solid, constraint=true];
"Series" -> "Category" [label=<<B>:IN_CATEGORY</B>>, style=solid, constraint=true];
"Series" -> "Tag" [label=<<B>:TAGGED</B>>, style=solid, constraint=true];
"Release" -> "Source" [label=<<B>:PUBLISHED_BY</B>>, style=solid, constraint=true];
"Release" -> "ReleaseDate" [label=<<B>:SCHEDULED_ON</B>>, style=solid, constraint=true];
"ReleaseTableElement" -> "Release" [label=<<B>:LISTED_IN</B>>, style=solid, constraint=true];
"ReleaseTableElement" -> "ReleaseTableElement" [label=<<B>:PART_OF</B>>, style=solid, constraint=true];
"ReleaseTableElement" -> "Series" [label=<<B>:SHOWS</B>>, style=solid, constraint=true];
"Category" -> "Category" [label=<<B>:CHILD_OF</B>>, style=solid, constraint=true];
"Tag" -> "TagGroup" [label=<<B>:IN_GROUP</B>>, style=solid, constraint=true];
"Document" -> "Release" [label=<<B>:DESCRIBES</B>>, style=dashed, constraint=false];
"Document" -> "Chunk" [label=<<B>:HAS_CHUNK</B>>, style=dashed, constraint=true];
"Provider" -> "CatalogSnapshot" [label=<<B>:EXPOSED_IN</B>>, style=dashed, constraint=true];
"Provider" -> "Dataset" [label=<<B>:PUBLISHED</B>>, style=dashed, constraint=true];
"CatalogSnapshot" -> "Category" [label=<<B>:CONTAINS_CATEGORY</B>>, style=dashed, constraint=false];
"CatalogSnapshot" -> "Series" [label=<<B>:CONTAINS_SERIES</B>>, style=dashed, constraint=false];
"CatalogSnapshot" -> "ApiResponseArtifact" [label=<<B>:RAW_RESPONSE</B>>, style=dashed, constraint=true];
"Dataset" -> "Series" [label=<<B>:CONTAINS_SERIES</B>>, style=dashed, constraint=false];
"Dataset" -> "RawArtifact" [label=<<B>:HAS_RAW_ARTIFACT</B>>, style=dashed, constraint=true];
"Dataset" -> "SourceMember" [label=<<B>:HAS_SOURCE_MEMBER</B>>, style=dashed, constraint=true];
"Dataset" -> "StagingRun" [label=<<B>:HAS_STAGING_RUN</B>>, style=dashed, constraint=true];
"Series" -> "SeriesVariant" [label=<<B>:HAS_TRANSFORMATION</B>>, style=dashed, constraint=false];
"SeriesVariant" -> "SourceMember" [label=<<B>:AVAILABLE_IN</B>>, style=dashed, constraint=true];
legend [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white" COLOR="#1f3557"><TR><TD COLSPAN="2" BGCOLOR="#1f3557"><FONT COLOR="white"><B>Community edition: what is and is not enforced</B></FONT></TD></TR><TR><TD ALIGN="LEFT">UNIQUE constraint</TD><TD ALIGN="LEFT">one per keyed label; backs a RANGE index</TD></TR><TR><TD ALIGN="LEFT">required / optional</TD><TD ALIGN="LEFT">observed on every node or not; existence constraints are Enterprise-only</TD></TR><TR><TD ALIGN="LEFT">composite keys</TD><TD ALIGN="LEFT">NODE KEY is Enterprise-only: rd_key and chunk_key are concatenated strings</TD></TR><TR><TD ALIGN="LEFT">relationships</TD><TD ALIGN="LEFT">no properties, no constraints; type and direction only</TD></TR><TR><TD COLSPAN="2" BGCOLOR="#1f3557"><FONT COLOR="white"><B>Type or format differences from the SQL schema</B></FONT></TD></TR><TR><TD ALIGN="LEFT">:ReleaseDate.release_key  STRING</TD><TD ALIGN="LEFT">release_date.release_id  INTEGER</TD></TR><TR><TD ALIGN="LEFT">:ReleaseTableElement.release_key  STRING</TD><TD ALIGN="LEFT">release_table_element.release_id  INTEGER</TD></TR><TR><TD ALIGN="LEFT">:ReleaseTableElement.parent_key  STRING</TD><TD ALIGN="LEFT">release_table_element.parent_id  INTEGER</TD></TR><TR><TD ALIGN="LEFT">:Category.category_id  STRING</TD><TD ALIGN="LEFT">category.category_id  INTEGER</TD></TR><TR><TD ALIGN="LEFT">:Category.parent_id  STRING</TD><TD ALIGN="LEFT">category.parent_id  INTEGER</TD></TR><TR><TD ALIGN="LEFT">:Series.last_updated  ZONED DATETIME</TD><TD ALIGN="LEFT">series.last_updated  TIMESTAMP</TD></TR><TR><TD COLSPAN="2" BGCOLOR="#1f3557"><FONT COLOR="white"><B>Load path</B></FONT></TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT" BALIGN="LEFT">fred_load.py writes CSVs; LOAD CSV in neo4j/cypher/003-006 MERGEs on each key<BR/>OBSERVATION stays in SQL; Document/Chunk come from the PDF registry</TD></TR></TABLE>>];
}
