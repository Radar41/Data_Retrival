digraph mysql {
graph [rankdir=LR, splines=spline, nodesep=0.45, ranksep=1.2, pad=0.4, fontname="Helvetica", labelloc=t, fontsize=20, label=<<B>FRED Metadata Catalog: Physical Design: MySQL 8 / MariaDB (InnoDB)</B><BR/><FONT POINT-SIZE="11">Adrian Aziza · ADIT2200-01 Database Management, Fall 2026</FONT>>];
node [shape=plaintext, fontname="Helvetica", fontsize=10];
edge [dir=both, color="#1f3557", fontname="Helvetica", fontsize=9, arrowsize=0.9, fontcolor="#333333"];
"frequency" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#1f3557"><TR><TD COLSPAN="4" BGCOLOR="#1f3557" CELLPADDING="5"><FONT COLOR="white" POINT-SIZE="12"><B>frequency</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="frequency_code_in"><FONT POINT-SIZE="8" COLOR="#7a1f1f">PK</FONT></TD><TD ALIGN="LEFT"><B>frequency_code</B></TD><TD ALIGN="LEFT"><FONT COLOR="#1f5537">VARCHAR(4)</FONT></TD><TD ALIGN="LEFT" PORT="frequency_code_out"><FONT POINT-SIZE="8">NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="frequency_name_in"><FONT POINT-SIZE="8" COLOR="#7a1f1f"> </FONT></TD><TD ALIGN="LEFT">frequency_name</TD><TD ALIGN="LEFT"><FONT COLOR="#1f5537">VARCHAR(40)</FONT></TD><TD ALIGN="LEFT" PORT="frequency_name_out"><FONT POINT-SIZE="8">NOT NULL</FONT></TD></TR><TR><TD COLSPAN="4" ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="#eef2f8"><FONT POINT-SIZE="8">pk_frequency PRIMARY KEY (frequency_code)<BR/>ENGINE=InnoDB  DEFAULT CHARSET=utf8mb4</FONT></TD></TR></TABLE>>];
"units" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#1f3557"><TR><TD COLSPAN="4" BGCOLOR="#1f3557" CELLPADDING="5"><FONT COLOR="white" POINT-SIZE="12"><B>units</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="units_code_in"><FONT POINT-SIZE="8" COLOR="#7a1f1f">PK</FONT></TD><TD ALIGN="LEFT"><B>units_code</B></TD><TD ALIGN="LEFT"><FONT COLOR="#1f5537">VARCHAR(40)</FONT></TD><TD ALIGN="LEFT" PORT="units_code_out"><FONT POINT-SIZE="8">NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="units_name_in"><FONT POINT-SIZE="8" COLOR="#7a1f1f"> </FONT></TD><TD ALIGN="LEFT">units_name</TD><TD ALIGN="LEFT"><FONT COLOR="#1f5537">VARCHAR(120)</FONT></TD><TD ALIGN="LEFT" PORT="units_name_out"><FONT POINT-SIZE="8">NOT NULL</FONT></TD></TR><TR><TD COLSPAN="4" ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="#eef2f8"><FONT POINT-SIZE="8">pk_units PRIMARY KEY (units_code)<BR/>ENGINE=InnoDB  DEFAULT CHARSET=utf8mb4</FONT></TD></TR></TABLE>>];
"seasonal_adjustment" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#1f3557"><TR><TD COLSPAN="4" BGCOLOR="#1f3557" CELLPADDING="5"><FONT COLOR="white" POINT-SIZE="12"><B>seasonal_adjustment</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="sa_code_in"><FONT POINT-SIZE="8" COLOR="#7a1f1f">PK</FONT></TD><TD ALIGN="LEFT"><B>sa_code</B></TD><TD ALIGN="LEFT"><FONT COLOR="#1f5537">VARCHAR(8)</FONT></TD><TD ALIGN="LEFT" PORT="sa_code_out"><FONT POINT-SIZE="8">NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="sa_name_in"><FONT POINT-SIZE="8" COLOR="#7a1f1f"> </FONT></TD><TD ALIGN="LEFT">sa_name</TD><TD ALIGN="LEFT"><FONT COLOR="#1f5537">VARCHAR(80)</FONT></TD><TD ALIGN="LEFT" PORT="sa_name_out"><FONT POINT-SIZE="8">NOT NULL</FONT></TD></TR><TR><TD COLSPAN="4" ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="#eef2f8"><FONT POINT-SIZE="8">pk_seasonal_adjustment PRIMARY KEY (sa_code)<BR/>ENGINE=InnoDB  DEFAULT CHARSET=utf8mb4</FONT></TD></TR></TABLE>>];
"source" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#1f3557"><TR><TD COLSPAN="4" BGCOLOR="#1f3557" CELLPADDING="5"><FONT COLOR="white" POINT-SIZE="12"><B>source</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="source_id_in"><FONT POINT-SIZE="8" COLOR="#7a1f1f">PK</FONT></TD><TD ALIGN="LEFT"><B>source_id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#1f5537">INT</FONT></TD><TD ALIGN="LEFT" PORT="source_id_out"><FONT POINT-SIZE="8">NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="source_name_in"><FONT POINT-SIZE="8" COLOR="#7a1f1f"> </FONT></TD><TD ALIGN="LEFT">source_name</TD><TD ALIGN="LEFT"><FONT COLOR="#1f5537">VARCHAR(200)</FONT></TD><TD ALIGN="LEFT" PORT="source_name_out"><FONT POINT-SIZE="8">NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="source_link_in"><FONT POINT-SIZE="8" COLOR="#7a1f1f"> </FONT></TD><TD ALIGN="LEFT">source_link</TD><TD ALIGN="LEFT"><FONT COLOR="#1f5537">VARCHAR(400)</FONT></TD><TD ALIGN="LEFT" PORT="source_link_out"><FONT POINT-SIZE="8">NULL</FONT></TD></TR><TR><TD COLSPAN="4" ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="#eef2f8"><FONT POINT-SIZE="8">pk_source PRIMARY KEY (source_id)<BR/>ENGINE=InnoDB  DEFAULT CHARSET=utf8mb4</FONT></TD></TR></TABLE>>];
"release" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#1f3557"><TR><TD COLSPAN="4" BGCOLOR="#1f3557" CELLPADDING="5"><FONT COLOR="white" POINT-SIZE="12"><B>`release`</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="release_id_in"><FONT POINT-SIZE="8" COLOR="#7a1f1f">PK</FONT></TD><TD ALIGN="LEFT"><B>release_id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#1f5537">INT</FONT></TD><TD ALIGN="LEFT" PORT="release_id_out"><FONT POINT-SIZE="8">NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="release_name_in"><FONT POINT-SIZE="8" COLOR="#7a1f1f"> </FONT></TD><TD ALIGN="LEFT">release_name</TD><TD ALIGN="LEFT"><FONT COLOR="#1f5537">VARCHAR(200)</FONT></TD><TD ALIGN="LEFT" PORT="release_name_out"><FONT POINT-SIZE="8">NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="press_release_in"><FONT POINT-SIZE="8" COLOR="#7a1f1f"> </FONT></TD><TD ALIGN="LEFT">press_release</TD><TD ALIGN="LEFT"><FONT COLOR="#1f5537">TINYINT(1)</FONT></TD><TD ALIGN="LEFT" PORT="press_release_out"><FONT POINT-SIZE="8">NOT NULL DEFAULT TRUE</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="release_link_in"><FONT POINT-SIZE="8" COLOR="#7a1f1f"> </FONT></TD><TD ALIGN="LEFT">release_link</TD><TD ALIGN="LEFT"><FONT COLOR="#1f5537">VARCHAR(400)</FONT></TD><TD ALIGN="LEFT" PORT="release_link_out"><FONT POINT-SIZE="8">NULL</FONT></TD></TR><TR><TD COLSPAN="4" ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="#eef2f8"><FONT POINT-SIZE="8">pk_release PRIMARY KEY (release_id)<BR/>ENGINE=InnoDB  DEFAULT CHARSET=utf8mb4</FONT></TD></TR></TABLE>>];
"release_source" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#1f3557"><TR><TD COLSPAN="4" BGCOLOR="#1f3557" CELLPADDING="5"><FONT COLOR="white" POINT-SIZE="12"><B>release_source</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="release_id_in"><FONT POINT-SIZE="8" COLOR="#7a1f1f">PK,FK</FONT></TD><TD ALIGN="LEFT"><B>release_id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#1f5537">INT</FONT></TD><TD ALIGN="LEFT" PORT="release_id_out"><FONT POINT-SIZE="8">NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="source_id_in"><FONT POINT-SIZE="8" COLOR="#7a1f1f">PK,FK</FONT></TD><TD ALIGN="LEFT"><B>source_id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#1f5537">INT</FONT></TD><TD ALIGN="LEFT" PORT="source_id_out"><FONT POINT-SIZE="8">NOT NULL</FONT></TD></TR><TR><TD COLSPAN="4" ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="#eef2f8"><FONT POINT-SIZE="8">pk_release_source PRIMARY KEY (release_id, source_id)<BR/><I>INDEX fk_release_source_source (source_id) — implicit, InnoDB FK</I><BR/>ENGINE=InnoDB  DEFAULT CHARSET=utf8mb4</FONT></TD></TR></TABLE>>];
"release_date" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#1f3557"><TR><TD COLSPAN="4" BGCOLOR="#1f3557" CELLPADDING="5"><FONT COLOR="white" POINT-SIZE="12"><B>release_date</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="release_id_in"><FONT POINT-SIZE="8" COLOR="#7a1f1f">PK,FK</FONT></TD><TD ALIGN="LEFT"><B>release_id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#1f5537">INT</FONT></TD><TD ALIGN="LEFT" PORT="release_id_out"><FONT POINT-SIZE="8">NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="release_date_in"><FONT POINT-SIZE="8" COLOR="#7a1f1f">PK</FONT></TD><TD ALIGN="LEFT"><B>release_date</B></TD><TD ALIGN="LEFT"><FONT COLOR="#1f5537">DATE</FONT></TD><TD ALIGN="LEFT" PORT="release_date_out"><FONT POINT-SIZE="8">NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="date_status_in"><FONT POINT-SIZE="8" COLOR="#7a1f1f"> </FONT></TD><TD ALIGN="LEFT">date_status</TD><TD ALIGN="LEFT"><FONT COLOR="#1f5537">VARCHAR(10)</FONT></TD><TD ALIGN="LEFT" PORT="date_status_out"><FONT POINT-SIZE="8">NOT NULL DEFAULT 'scheduled'</FONT></TD></TR><TR><TD COLSPAN="4" ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="#eef2f8"><FONT POINT-SIZE="8">pk_release_date PRIMARY KEY (release_id, release_date)<BR/>ck_release_date_status CHECK (date_status IN ('scheduled', 'actual'))<BR/>INDEX ix_release_date_date (release_date)<BR/>ENGINE=InnoDB  DEFAULT CHARSET=utf8mb4</FONT></TD></TR></TABLE>>];
"category" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#1f3557"><TR><TD COLSPAN="4" BGCOLOR="#1f3557" CELLPADDING="5"><FONT COLOR="white" POINT-SIZE="12"><B>category</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="category_id_in"><FONT POINT-SIZE="8" COLOR="#7a1f1f">PK</FONT></TD><TD ALIGN="LEFT"><B>category_id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#1f5537">INT</FONT></TD><TD ALIGN="LEFT" PORT="category_id_out"><FONT POINT-SIZE="8">NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="category_name_in"><FONT POINT-SIZE="8" COLOR="#7a1f1f"> </FONT></TD><TD ALIGN="LEFT">category_name</TD><TD ALIGN="LEFT"><FONT COLOR="#1f5537">VARCHAR(200)</FONT></TD><TD ALIGN="LEFT" PORT="category_name_out"><FONT POINT-SIZE="8">NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="parent_id_in"><FONT POINT-SIZE="8" COLOR="#7a1f1f">FK</FONT></TD><TD ALIGN="LEFT">parent_id</TD><TD ALIGN="LEFT"><FONT COLOR="#1f5537">INT</FONT></TD><TD ALIGN="LEFT" PORT="parent_id_out"><FONT POINT-SIZE="8">NULL</FONT></TD></TR><TR><TD COLSPAN="4" ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="#eef2f8"><FONT POINT-SIZE="8">pk_category PRIMARY KEY (category_id)<BR/><I>INDEX fk_category_parent (parent_id) — implicit, InnoDB FK</I><BR/>ENGINE=InnoDB  DEFAULT CHARSET=utf8mb4</FONT></TD></TR></TABLE>>];
"tag_group" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#1f3557"><TR><TD COLSPAN="4" BGCOLOR="#1f3557" CELLPADDING="5"><FONT COLOR="white" POINT-SIZE="12"><B>tag_group</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="group_id_in"><FONT POINT-SIZE="8" COLOR="#7a1f1f">PK</FONT></TD><TD ALIGN="LEFT"><B>group_id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#1f5537">VARCHAR(8)</FONT></TD><TD ALIGN="LEFT" PORT="group_id_out"><FONT POINT-SIZE="8">NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="group_name_in"><FONT POINT-SIZE="8" COLOR="#7a1f1f"> </FONT></TD><TD ALIGN="LEFT">group_name</TD><TD ALIGN="LEFT"><FONT COLOR="#1f5537">VARCHAR(80)</FONT></TD><TD ALIGN="LEFT" PORT="group_name_out"><FONT POINT-SIZE="8">NOT NULL</FONT></TD></TR><TR><TD COLSPAN="4" ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="#eef2f8"><FONT POINT-SIZE="8">pk_tag_group PRIMARY KEY (group_id)<BR/>ENGINE=InnoDB  DEFAULT CHARSET=utf8mb4</FONT></TD></TR></TABLE>>];
"tag" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#1f3557"><TR><TD COLSPAN="4" BGCOLOR="#1f3557" CELLPADDING="5"><FONT COLOR="white" POINT-SIZE="12"><B>tag</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="tag_name_in"><FONT POINT-SIZE="8" COLOR="#7a1f1f">PK</FONT></TD><TD ALIGN="LEFT"><B>tag_name</B></TD><TD ALIGN="LEFT"><FONT COLOR="#1f5537">VARCHAR(120)</FONT></TD><TD ALIGN="LEFT" PORT="tag_name_out"><FONT POINT-SIZE="8">NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="group_id_in"><FONT POINT-SIZE="8" COLOR="#7a1f1f">FK</FONT></TD><TD ALIGN="LEFT">group_id</TD><TD ALIGN="LEFT"><FONT COLOR="#1f5537">VARCHAR(8)</FONT></TD><TD ALIGN="LEFT" PORT="group_id_out"><FONT POINT-SIZE="8">NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="tag_notes_in"><FONT POINT-SIZE="8" COLOR="#7a1f1f"> </FONT></TD><TD ALIGN="LEFT">tag_notes</TD><TD ALIGN="LEFT"><FONT COLOR="#1f5537">VARCHAR(400)</FONT></TD><TD ALIGN="LEFT" PORT="tag_notes_out"><FONT POINT-SIZE="8">NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="popularity_in"><FONT POINT-SIZE="8" COLOR="#7a1f1f"> </FONT></TD><TD ALIGN="LEFT">popularity</TD><TD ALIGN="LEFT"><FONT COLOR="#1f5537">SMALLINT</FONT></TD><TD ALIGN="LEFT" PORT="popularity_out"><FONT POINT-SIZE="8">NULL</FONT></TD></TR><TR><TD COLSPAN="4" ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="#eef2f8"><FONT POINT-SIZE="8">pk_tag PRIMARY KEY (tag_name)<BR/><I>INDEX fk_tag_tag_group (group_id) — implicit, InnoDB FK</I><BR/>ENGINE=InnoDB  DEFAULT CHARSET=utf8mb4</FONT></TD></TR></TABLE>>];
"series" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#1f3557"><TR><TD COLSPAN="4" BGCOLOR="#1f3557" CELLPADDING="5"><FONT COLOR="white" POINT-SIZE="12"><B>series</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="series_id_in"><FONT POINT-SIZE="8" COLOR="#7a1f1f">PK</FONT></TD><TD ALIGN="LEFT"><B>series_id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#1f5537">VARCHAR(40)</FONT></TD><TD ALIGN="LEFT" PORT="series_id_out"><FONT POINT-SIZE="8">NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="title_in"><FONT POINT-SIZE="8" COLOR="#7a1f1f"> </FONT></TD><TD ALIGN="LEFT">title</TD><TD ALIGN="LEFT"><FONT COLOR="#1f5537">VARCHAR(300)</FONT></TD><TD ALIGN="LEFT" PORT="title_out"><FONT POINT-SIZE="8">NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="release_id_in"><FONT POINT-SIZE="8" COLOR="#7a1f1f">FK</FONT></TD><TD ALIGN="LEFT">release_id</TD><TD ALIGN="LEFT"><FONT COLOR="#1f5537">INT</FONT></TD><TD ALIGN="LEFT" PORT="release_id_out"><FONT POINT-SIZE="8">NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="frequency_code_in"><FONT POINT-SIZE="8" COLOR="#7a1f1f">FK</FONT></TD><TD ALIGN="LEFT">frequency_code</TD><TD ALIGN="LEFT"><FONT COLOR="#1f5537">VARCHAR(4)</FONT></TD><TD ALIGN="LEFT" PORT="frequency_code_out"><FONT POINT-SIZE="8">NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="units_code_in"><FONT POINT-SIZE="8" COLOR="#7a1f1f">FK</FONT></TD><TD ALIGN="LEFT">units_code</TD><TD ALIGN="LEFT"><FONT COLOR="#1f5537">VARCHAR(40)</FONT></TD><TD ALIGN="LEFT" PORT="units_code_out"><FONT POINT-SIZE="8">NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="sa_code_in"><FONT POINT-SIZE="8" COLOR="#7a1f1f">FK</FONT></TD><TD ALIGN="LEFT">sa_code</TD><TD ALIGN="LEFT"><FONT COLOR="#1f5537">VARCHAR(8)</FONT></TD><TD ALIGN="LEFT" PORT="sa_code_out"><FONT POINT-SIZE="8">NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="observation_start_in"><FONT POINT-SIZE="8" COLOR="#7a1f1f"> </FONT></TD><TD ALIGN="LEFT">observation_start <FONT POINT-SIZE="8">(derived)</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#1f5537">DATE</FONT></TD><TD ALIGN="LEFT" PORT="observation_start_out"><FONT POINT-SIZE="8">NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="observation_end_in"><FONT POINT-SIZE="8" COLOR="#7a1f1f"> </FONT></TD><TD ALIGN="LEFT">observation_end <FONT POINT-SIZE="8">(derived)</FONT></TD><TD ALIGN="LEFT"><FONT COLOR="#1f5537">DATE</FONT></TD><TD ALIGN="LEFT" PORT="observation_end_out"><FONT POINT-SIZE="8">NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="last_updated_in"><FONT POINT-SIZE="8" COLOR="#7a1f1f"> </FONT></TD><TD ALIGN="LEFT">last_updated</TD><TD ALIGN="LEFT"><FONT COLOR="#1f5537">TIMESTAMP</FONT></TD><TD ALIGN="LEFT" PORT="last_updated_out"><FONT POINT-SIZE="8">NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="popularity_in"><FONT POINT-SIZE="8" COLOR="#7a1f1f"> </FONT></TD><TD ALIGN="LEFT">popularity</TD><TD ALIGN="LEFT"><FONT COLOR="#1f5537">SMALLINT</FONT></TD><TD ALIGN="LEFT" PORT="popularity_out"><FONT POINT-SIZE="8">NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="notes_in"><FONT POINT-SIZE="8" COLOR="#7a1f1f"> </FONT></TD><TD ALIGN="LEFT">notes</TD><TD ALIGN="LEFT"><FONT COLOR="#1f5537">TEXT</FONT></TD><TD ALIGN="LEFT" PORT="notes_out"><FONT POINT-SIZE="8">NULL</FONT></TD></TR><TR><TD COLSPAN="4" ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="#eef2f8"><FONT POINT-SIZE="8">pk_series PRIMARY KEY (series_id)<BR/>ck_series_obs_range CHECK (observation_end IS NULL OR observation_start IS NULL OR observation_end &gt;= observation_start)<BR/>INDEX ix_series_frequency_sa (frequency_code, sa_code)<BR/>INDEX ix_series_last_updated (last_updated)<BR/><I>INDEX fk_series_release (release_id) — implicit, InnoDB FK</I><BR/><I>INDEX fk_series_units (units_code) — implicit, InnoDB FK</I><BR/><I>INDEX fk_series_sa (sa_code) — implicit, InnoDB FK</I><BR/>ENGINE=InnoDB  DEFAULT CHARSET=utf8mb4</FONT></TD></TR></TABLE>>];
"series_category" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#1f3557"><TR><TD COLSPAN="4" BGCOLOR="#1f3557" CELLPADDING="5"><FONT COLOR="white" POINT-SIZE="12"><B>series_category</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="series_id_in"><FONT POINT-SIZE="8" COLOR="#7a1f1f">PK,FK</FONT></TD><TD ALIGN="LEFT"><B>series_id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#1f5537">VARCHAR(40)</FONT></TD><TD ALIGN="LEFT" PORT="series_id_out"><FONT POINT-SIZE="8">NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="category_id_in"><FONT POINT-SIZE="8" COLOR="#7a1f1f">PK,FK</FONT></TD><TD ALIGN="LEFT"><B>category_id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#1f5537">INT</FONT></TD><TD ALIGN="LEFT" PORT="category_id_out"><FONT POINT-SIZE="8">NOT NULL</FONT></TD></TR><TR><TD COLSPAN="4" ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="#eef2f8"><FONT POINT-SIZE="8">pk_series_category PRIMARY KEY (series_id, category_id)<BR/><I>INDEX fk_series_category_category (category_id) — implicit, InnoDB FK</I><BR/>ENGINE=InnoDB  DEFAULT CHARSET=utf8mb4</FONT></TD></TR></TABLE>>];
"series_tag" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#1f3557"><TR><TD COLSPAN="4" BGCOLOR="#1f3557" CELLPADDING="5"><FONT COLOR="white" POINT-SIZE="12"><B>series_tag</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="series_id_in"><FONT POINT-SIZE="8" COLOR="#7a1f1f">PK,FK</FONT></TD><TD ALIGN="LEFT"><B>series_id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#1f5537">VARCHAR(40)</FONT></TD><TD ALIGN="LEFT" PORT="series_id_out"><FONT POINT-SIZE="8">NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="tag_name_in"><FONT POINT-SIZE="8" COLOR="#7a1f1f">PK,FK</FONT></TD><TD ALIGN="LEFT"><B>tag_name</B></TD><TD ALIGN="LEFT"><FONT COLOR="#1f5537">VARCHAR(120)</FONT></TD><TD ALIGN="LEFT" PORT="tag_name_out"><FONT POINT-SIZE="8">NOT NULL</FONT></TD></TR><TR><TD COLSPAN="4" ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="#eef2f8"><FONT POINT-SIZE="8">pk_series_tag PRIMARY KEY (series_id, tag_name)<BR/><I>INDEX fk_series_tag_tag (tag_name) — implicit, InnoDB FK</I><BR/>ENGINE=InnoDB  DEFAULT CHARSET=utf8mb4</FONT></TD></TR></TABLE>>];
"observation" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#1f3557"><TR><TD COLSPAN="4" BGCOLOR="#1f3557" CELLPADDING="5"><FONT COLOR="white" POINT-SIZE="12"><B>observation</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="series_id_in"><FONT POINT-SIZE="8" COLOR="#7a1f1f">PK,FK</FONT></TD><TD ALIGN="LEFT"><B>series_id</B></TD><TD ALIGN="LEFT"><FONT COLOR="#1f5537">VARCHAR(40)</FONT></TD><TD ALIGN="LEFT" PORT="series_id_out"><FONT POINT-SIZE="8">NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="observation_date_in"><FONT POINT-SIZE="8" COLOR="#7a1f1f">PK</FONT></TD><TD ALIGN="LEFT"><B>observation_date</B></TD><TD ALIGN="LEFT"><FONT COLOR="#1f5537">DATE</FONT></TD><TD ALIGN="LEFT" PORT="observation_date_out"><FONT POINT-SIZE="8">NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="realtime_start_in"><FONT POINT-SIZE="8" COLOR="#7a1f1f">PK</FONT></TD><TD ALIGN="LEFT"><B>realtime_start</B></TD><TD ALIGN="LEFT"><FONT COLOR="#1f5537">DATE</FONT></TD><TD ALIGN="LEFT" PORT="realtime_start_out"><FONT POINT-SIZE="8">NOT NULL</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="realtime_end_in"><FONT POINT-SIZE="8" COLOR="#7a1f1f"> </FONT></TD><TD ALIGN="LEFT">realtime_end</TD><TD ALIGN="LEFT"><FONT COLOR="#1f5537">DATE</FONT></TD><TD ALIGN="LEFT" PORT="realtime_end_out"><FONT POINT-SIZE="8">NOT NULL DEFAULT '9999-12-31'</FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="value_in"><FONT POINT-SIZE="8" COLOR="#7a1f1f"> </FONT></TD><TD ALIGN="LEFT">value</TD><TD ALIGN="LEFT"><FONT COLOR="#1f5537">DECIMAL(24,8)</FONT></TD><TD ALIGN="LEFT" PORT="value_out"><FONT POINT-SIZE="8">NULL</FONT></TD></TR><TR><TD COLSPAN="4" ALIGN="LEFT" BALIGN="LEFT" BGCOLOR="#eef2f8"><FONT POINT-SIZE="8">pk_observation PRIMARY KEY (series_id, observation_date, realtime_start)<BR/>ck_observation_realtime CHECK (realtime_end &gt;= realtime_start)<BR/>INDEX ix_observation_current (series_id, realtime_end, observation_date)<BR/>INDEX ix_observation_vintage (series_id, observation_date, realtime_end)<BR/>ENGINE=InnoDB  DEFAULT CHARSET=utf8mb4</FONT></TD></TR></TABLE>>];
"release":"release_id_out":e -> "release_source":"release_id_in":w [arrowtail=teetee, arrowhead=crowtee, style=solid, penwidth=1.6, label=<fk_release_source_release<BR/><FONT POINT-SIZE="8">ON DELETE CASCADE</FONT>>];
"source":"source_id_out":e -> "release_source":"source_id_in":w [arrowtail=teetee, arrowhead=crowtee, style=solid, penwidth=1.6, label=<fk_release_source_source<BR/><FONT POINT-SIZE="8">ON DELETE RESTRICT</FONT>>];
"release":"release_id_out":e -> "release_date":"release_id_in":w [arrowtail=teetee, arrowhead=crowtee, style=solid, penwidth=1.6, label=<fk_release_date_release<BR/><FONT POINT-SIZE="8">ON DELETE CASCADE</FONT>>];
"category":"category_id_out":e -> "category":"parent_id_in":w [arrowtail=teeodot, arrowhead=crowodot, style=dashed, penwidth=1.1, label=<fk_category_parent<BR/><FONT POINT-SIZE="8">ON DELETE RESTRICT</FONT>>];
"tag_group":"group_id_out":e -> "tag":"group_id_in":w [arrowtail=teetee, arrowhead=crowtee, style=dashed, penwidth=1.1, label=<fk_tag_tag_group<BR/><FONT POINT-SIZE="8">ON DELETE RESTRICT</FONT>>];
"release":"release_id_out":e -> "series":"release_id_in":w [arrowtail=teetee, arrowhead=crowtee, style=dashed, penwidth=1.1, label=<fk_series_release<BR/><FONT POINT-SIZE="8">ON DELETE RESTRICT</FONT>>];
"frequency":"frequency_code_out":e -> "series":"frequency_code_in":w [arrowtail=teetee, arrowhead=crowodot, style=dashed, penwidth=1.1, label=<fk_series_frequency<BR/><FONT POINT-SIZE="8">ON DELETE RESTRICT</FONT>>];
"units":"units_code_out":e -> "series":"units_code_in":w [arrowtail=teetee, arrowhead=crowodot, style=dashed, penwidth=1.1, label=<fk_series_units<BR/><FONT POINT-SIZE="8">ON DELETE RESTRICT</FONT>>];
"seasonal_adjustment":"sa_code_out":e -> "series":"sa_code_in":w [arrowtail=teetee, arrowhead=crowodot, style=dashed, penwidth=1.1, label=<fk_series_sa<BR/><FONT POINT-SIZE="8">ON DELETE RESTRICT</FONT>>];
"series":"series_id_out":e -> "series_category":"series_id_in":w [arrowtail=teetee, arrowhead=crowtee, style=solid, penwidth=1.6, label=<fk_series_category_series<BR/><FONT POINT-SIZE="8">ON DELETE CASCADE</FONT>>];
"category":"category_id_out":e -> "series_category":"category_id_in":w [arrowtail=teetee, arrowhead=crowodot, style=solid, penwidth=1.6, label=<fk_series_category_category<BR/><FONT POINT-SIZE="8">ON DELETE RESTRICT</FONT>>];
"series":"series_id_out":e -> "series_tag":"series_id_in":w [arrowtail=teetee, arrowhead=crowodot, style=solid, penwidth=1.6, label=<fk_series_tag_series<BR/><FONT POINT-SIZE="8">ON DELETE CASCADE</FONT>>];
"tag":"tag_name_out":e -> "series_tag":"tag_name_in":w [arrowtail=teetee, arrowhead=crowtee, style=solid, penwidth=1.6, label=<fk_series_tag_tag<BR/><FONT POINT-SIZE="8">ON DELETE RESTRICT</FONT>>];
"series":"series_id_out":e -> "observation":"series_id_in":w [arrowtail=teetee, arrowhead=crowodot, style=solid, penwidth=1.6, label=<fk_observation_series<BR/><FONT POINT-SIZE="8">ON DELETE CASCADE</FONT>>];
{rank=same; frequency; units; seasonal_adjustment;}
{rank=same; tag_group; source;}
legend [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#1f3557"><TR><TD COLSPAN="2" BGCOLOR="#1f3557"><FONT COLOR="white"><B>Notation</B></FONT></TD></TR><TR><TD ALIGN="LEFT">solid line</TD><TD ALIGN="LEFT">identifying (FK is part of the PK)</TD></TR><TR><TD ALIGN="LEFT">dashed line</TD><TD ALIGN="LEFT">non-identifying</TD></TR><TR><TD ALIGN="LEFT">|| and crow's foot</TD><TD ALIGN="LEFT">exactly one / many; a circle means zero is allowed</TD></TR><TR><TD ALIGN="LEFT"><B>bold</B> / PK, FK</TD><TD ALIGN="LEFT">key columns</TD></TR><TR><TD ALIGN="LEFT">edge label</TD><TD ALIGN="LEFT">FK constraint name and ON DELETE action</TD></TR><TR><TD COLSPAN="2" BGCOLOR="#1f3557"><FONT COLOR="white"><B>Triggers, functions, procedures</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><B>add_vintage</B><BR/><FONT POINT-SIZE="8">procedure CALL instead of INSERT</FONT></TD><TD ALIGN="LEFT">Rule 11 in MySQL: a trigger may not update its own table (error 1442)</TD></TR><TR><TD ALIGN="LEFT"><B>refresh_series_range</B><BR/><FONT POINT-SIZE="8">trigger AFTER INSERT ON observation</FONT></TD><TD ALIGN="LEFT">Keeps series.observation_start/end consistent</TD></TR><TR><TD ALIGN="LEFT"><B>value_as_of</B><BR/><FONT POINT-SIZE="8">function (series, obs_date, as_of)</FONT></TD><TD ALIGN="LEFT">Value of a series as it was known on a date</TD></TR><TR><TD ALIGN="LEFT"><B>post_release</B><BR/><FONT POINT-SIZE="8">procedure (release_id, date)</FONT></TD><TD ALIGN="LEFT">Marks a release date actual</TD></TR><TR><TD COLSPAN="2" BGCOLOR="#1f3557"><FONT COLOR="white"><B>Differences from PostgreSQL</B></FONT></TD></TR><TR><TD COLSPAN="2" ALIGN="LEFT" BALIGN="LEFT">RELEASE is reserved: table is `release`<BR/>INTEGER stored as INT, BOOLEAN as TINYINT(1)<BR/>Vintage rule is the add_vintage() procedure, not a trigger<BR/>FK-only indexes omitted: InnoDB creates them (shown in italics)</TD></TR></TABLE>>];
}
