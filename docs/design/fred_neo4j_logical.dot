digraph graph_logical {
graph [rankdir=LR, compound=true, splines=spline, nodesep=0.35, ranksep=1.0, pad=0.4, fontname="Helvetica", labelloc=t, fontsize=20, label=<<B>FRED Metadata Catalog: Neo4j Logical Design (property graph model)</B><BR/><FONT POINT-SIZE="11">Adrian Aziza · ADIT2200-01 Database Management, Fall 2026</FONT>>];
node [shape=plaintext, fontname="Helvetica", fontsize=10];
edge [color="#1f3557", fontname="Helvetica", fontsize=9, arrowsize=0.8, fontcolor="#333333"];
subgraph cluster_catalog {
label=<<B>FRED catalog (from the relational model)</B>>; fontsize=13; style="rounded,filled"; fillcolor="#e8eef7"; color="#9aa7b8";
"Source" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" STYLE="ROUNDED" BGCOLOR="white" COLOR="#1f3557"><TR><TD COLSPAN="1" BGCOLOR="#1f3557" CELLPADDING="5"><FONT COLOR="white" POINT-SIZE="12"><B>:Source</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="8"><I>from table source</I></FONT></TD></TR><TR><TD ALIGN="LEFT"><U><B>source_key</B></U></TD></TR><TR><TD ALIGN="LEFT">source_id</TD></TR><TR><TD ALIGN="LEFT">provider_id</TD></TR><TR><TD ALIGN="LEFT">name</TD></TR><TR><TD ALIGN="LEFT">link</TD></TR></TABLE>>];
"Release" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" STYLE="ROUNDED" BGCOLOR="white" COLOR="#1f3557"><TR><TD COLSPAN="1" BGCOLOR="#1f3557" CELLPADDING="5"><FONT COLOR="white" POINT-SIZE="12"><B>:Release</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="8"><I>from table release</I></FONT></TD></TR><TR><TD ALIGN="LEFT"><U><B>release_key</B></U></TD></TR><TR><TD ALIGN="LEFT">release_id</TD></TR><TR><TD ALIGN="LEFT">provider_id</TD></TR><TR><TD ALIGN="LEFT">name</TD></TR><TR><TD ALIGN="LEFT">press_release</TD></TR><TR><TD ALIGN="LEFT">link</TD></TR></TABLE>>];
"ReleaseDate" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" STYLE="ROUNDED" BGCOLOR="white" COLOR="#1f3557"><TR><TD COLSPAN="1" BGCOLOR="#1f3557" CELLPADDING="5"><FONT COLOR="white" POINT-SIZE="12"><B>:ReleaseDate</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="8"><I>from table release_date</I></FONT></TD></TR><TR><TD ALIGN="LEFT"><U><B>rd_key</B></U></TD></TR><TR><TD ALIGN="LEFT">release_key</TD></TR><TR><TD ALIGN="LEFT">date</TD></TR><TR><TD ALIGN="LEFT">status</TD></TR></TABLE>>];
"ReleaseTableElement" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" STYLE="ROUNDED" BGCOLOR="white" COLOR="#1f3557"><TR><TD COLSPAN="1" BGCOLOR="#1f3557" CELLPADDING="5"><FONT COLOR="white" POINT-SIZE="12"><B>:ReleaseTableElement</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="8"><I>from table release_table_element</I></FONT></TD></TR><TR><TD ALIGN="LEFT"><U><B>element_key</B></U></TD></TR><TR><TD ALIGN="LEFT">element_id</TD></TR><TR><TD ALIGN="LEFT">release_key</TD></TR><TR><TD ALIGN="LEFT">parent_key</TD></TR><TR><TD ALIGN="LEFT">type</TD></TR><TR><TD ALIGN="LEFT">name</TD></TR><TR><TD ALIGN="LEFT">level</TD></TR><TR><TD ALIGN="LEFT">line</TD></TR><TR><TD ALIGN="LEFT">series_id</TD></TR></TABLE>>];
"Frequency" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" STYLE="ROUNDED" BGCOLOR="white" COLOR="#1f3557"><TR><TD COLSPAN="1" BGCOLOR="#1f3557" CELLPADDING="5"><FONT COLOR="white" POINT-SIZE="12"><B>:Frequency</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="8"><I>from table frequency</I></FONT></TD></TR><TR><TD ALIGN="LEFT"><U><B>code</B></U></TD></TR><TR><TD ALIGN="LEFT">name</TD></TR></TABLE>>];
"Units" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" STYLE="ROUNDED" BGCOLOR="white" COLOR="#1f3557"><TR><TD COLSPAN="1" BGCOLOR="#1f3557" CELLPADDING="5"><FONT COLOR="white" POINT-SIZE="12"><B>:Units</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="8"><I>from table units</I></FONT></TD></TR><TR><TD ALIGN="LEFT"><U><B>code</B></U></TD></TR><TR><TD ALIGN="LEFT">name</TD></TR></TABLE>>];
"SeasonalAdjustment" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" STYLE="ROUNDED" BGCOLOR="white" COLOR="#1f3557"><TR><TD COLSPAN="1" BGCOLOR="#1f3557" CELLPADDING="5"><FONT COLOR="white" POINT-SIZE="12"><B>:SeasonalAdjustment</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="8"><I>from table seasonal_adjustment</I></FONT></TD></TR><TR><TD ALIGN="LEFT"><U><B>code</B></U></TD></TR><TR><TD ALIGN="LEFT">name</TD></TR></TABLE>>];
"Category" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" STYLE="ROUNDED" BGCOLOR="white" COLOR="#1f3557"><TR><TD COLSPAN="1" BGCOLOR="#1f3557" CELLPADDING="5"><FONT COLOR="white" POINT-SIZE="12"><B>:Category</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="8"><I>from table category</I></FONT></TD></TR><TR><TD ALIGN="LEFT"><U><B>provider_id</B></U></TD></TR><TR><TD ALIGN="LEFT"><U><B>category_id</B></U></TD></TR><TR><TD ALIGN="LEFT">category_key</TD></TR><TR><TD ALIGN="LEFT">name</TD></TR><TR><TD ALIGN="LEFT">parent_id</TD></TR><TR><TD ALIGN="LEFT">is_root</TD></TR><TR><TD ALIGN="LEFT">catalog_source</TD></TR><TR><TD ALIGN="LEFT">import_file</TD></TR></TABLE>>];
"TagGroup" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" STYLE="ROUNDED" BGCOLOR="white" COLOR="#1f3557"><TR><TD COLSPAN="1" BGCOLOR="#1f3557" CELLPADDING="5"><FONT COLOR="white" POINT-SIZE="12"><B>:TagGroup</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="8"><I>from table tag_group</I></FONT></TD></TR><TR><TD ALIGN="LEFT"><U><B>group_id</B></U></TD></TR><TR><TD ALIGN="LEFT">name</TD></TR></TABLE>>];
"Tag" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" STYLE="ROUNDED" BGCOLOR="white" COLOR="#1f3557"><TR><TD COLSPAN="1" BGCOLOR="#1f3557" CELLPADDING="5"><FONT COLOR="white" POINT-SIZE="12"><B>:Tag</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="8"><I>from table tag</I></FONT></TD></TR><TR><TD ALIGN="LEFT"><U><B>tag_name</B></U></TD></TR><TR><TD ALIGN="LEFT">notes</TD></TR><TR><TD ALIGN="LEFT">popularity</TD></TR></TABLE>>];
"Series" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" STYLE="ROUNDED" BGCOLOR="white" COLOR="#1f3557"><TR><TD COLSPAN="1" BGCOLOR="#1f3557" CELLPADDING="5"><FONT COLOR="white" POINT-SIZE="12"><B>:Series</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="8"><I>from table series</I></FONT></TD></TR><TR><TD ALIGN="LEFT"><U><B>catalog_key</B></U></TD></TR><TR><TD ALIGN="LEFT">series_id</TD></TR><TR><TD ALIGN="LEFT">title</TD></TR><TR><TD ALIGN="LEFT">observation_start</TD></TR><TR><TD ALIGN="LEFT">observation_end</TD></TR><TR><TD ALIGN="LEFT">last_updated</TD></TR><TR><TD ALIGN="LEFT">popularity</TD></TR><TR><TD ALIGN="LEFT">notes</TD></TR><TR><TD ALIGN="LEFT">series_catalog_key</TD></TR><TR><TD ALIGN="LEFT">provider_id</TD></TR><TR><TD ALIGN="LEFT">dataset_id</TD></TR><TR><TD ALIGN="LEFT">source_datalist_id</TD></TR><TR><TD ALIGN="LEFT">raw_archive_sha256</TD></TR><TR><TD ALIGN="LEFT">frequency</TD></TR><TR><TD ALIGN="LEFT">seasonal_adjustment</TD></TR><TR><TD ALIGN="LEFT">units_level</TD></TR><TR><TD ALIGN="LEFT">release</TD></TR><TR><TD ALIGN="LEFT">source</TD></TR><TR><TD ALIGN="LEFT">real_time_start</TD></TR><TR><TD ALIGN="LEFT">period_end</TD></TR></TABLE>>];
}
subgraph cluster_documents {
label=<<B>Press releases (unstructured)</B>>; fontsize=13; style="rounded,filled"; fillcolor="#eef6ea"; color="#9aa7b8";
"Document" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" STYLE="ROUNDED" BGCOLOR="white" COLOR="#1f3557"><TR><TD COLSPAN="1" BGCOLOR="#1f3557" CELLPADDING="5"><FONT COLOR="white" POINT-SIZE="12"><B>:Document</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><U><B>doc_id</B></U></TD></TR><TR><TD ALIGN="LEFT">release_key</TD></TR><TR><TD ALIGN="LEFT">release_date</TD></TR><TR><TD ALIGN="LEFT">kind</TD></TR><TR><TD ALIGN="LEFT">title</TD></TR><TR><TD ALIGN="LEFT">source_name</TD></TR><TR><TD ALIGN="LEFT">file_type</TD></TR><TR><TD ALIGN="LEFT">path</TD></TR><TR><TD ALIGN="LEFT">sha256</TD></TR><TR><TD ALIGN="LEFT">source</TD></TR><TR><TD ALIGN="LEFT">retrieved_at</TD></TR></TABLE>>];
"Chunk" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" STYLE="ROUNDED" BGCOLOR="white" COLOR="#1f3557"><TR><TD COLSPAN="1" BGCOLOR="#1f3557" CELLPADDING="5"><FONT COLOR="white" POINT-SIZE="12"><B>:Chunk</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><U><B>chunk_key</B></U></TD></TR><TR><TD ALIGN="LEFT">doc_id</TD></TR><TR><TD ALIGN="LEFT">seq</TD></TR><TR><TD ALIGN="LEFT">text</TD></TR><TR><TD ALIGN="LEFT">embedding</TD></TR></TABLE>>];
}
subgraph cluster_lineage {
label=<<B>Provenance and lineage</B>>; fontsize=13; style="rounded,filled"; fillcolor="#f6f0e6"; color="#9aa7b8";
"Provider" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" STYLE="ROUNDED" BGCOLOR="white" COLOR="#1f3557"><TR><TD COLSPAN="1" BGCOLOR="#1f3557" CELLPADDING="5"><FONT COLOR="white" POINT-SIZE="12"><B>:Provider</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><U><B>provider_id</B></U></TD></TR><TR><TD ALIGN="LEFT">name</TD></TR><TR><TD ALIGN="LEFT">short_name</TD></TR><TR><TD ALIGN="LEFT">display_name</TD></TR><TR><TD ALIGN="LEFT">description</TD></TR><TR><TD ALIGN="LEFT">project</TD></TR><TR><TD ALIGN="LEFT">api_base_url</TD></TR><TR><TD ALIGN="LEFT">homepage_url</TD></TR></TABLE>>];
"CatalogSnapshot" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" STYLE="ROUNDED" BGCOLOR="white" COLOR="#1f3557"><TR><TD COLSPAN="1" BGCOLOR="#1f3557" CELLPADDING="5"><FONT COLOR="white" POINT-SIZE="12"><B>:CatalogSnapshot</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><U><B>snapshot_id</B></U></TD></TR><TR><TD ALIGN="LEFT">provider_id</TD></TR><TR><TD ALIGN="LEFT">endpoint</TD></TR><TR><TD ALIGN="LEFT">schema_version</TD></TR><TR><TD ALIGN="LEFT">retrieved_at_utc</TD></TR><TR><TD ALIGN="LEFT">request_parameters</TD></TR><TR><TD ALIGN="LEFT">category_count</TD></TR><TR><TD ALIGN="LEFT">snapshot_directory</TD></TR><TR><TD ALIGN="LEFT">manifest_file</TD></TR><TR><TD ALIGN="LEFT">normalized_categories_file</TD></TR><TR><TD ALIGN="LEFT">neo4j_import_file</TD></TR></TABLE>>];
"ApiResponseArtifact" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" STYLE="ROUNDED" BGCOLOR="white" COLOR="#1f3557"><TR><TD COLSPAN="1" BGCOLOR="#1f3557" CELLPADDING="5"><FONT COLOR="white" POINT-SIZE="12"><B>:ApiResponseArtifact</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><U><B>path</B></U></TD></TR><TR><TD ALIGN="LEFT">provider_id</TD></TR><TR><TD ALIGN="LEFT">snapshot_id</TD></TR><TR><TD ALIGN="LEFT">endpoint</TD></TR><TR><TD ALIGN="LEFT">format</TD></TR><TR><TD ALIGN="LEFT">kind</TD></TR></TABLE>>];
"Dataset" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" STYLE="ROUNDED" BGCOLOR="white" COLOR="#1f3557"><TR><TD COLSPAN="1" BGCOLOR="#1f3557" CELLPADDING="5"><FONT COLOR="white" POINT-SIZE="12"><B>:Dataset</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><U><B>dataset_id</B></U></TD></TR><TR><TD ALIGN="LEFT">title</TD></TR><TR><TD ALIGN="LEFT">source_datalist_id</TD></TR><TR><TD ALIGN="LEFT">source_url</TD></TR><TR><TD ALIGN="LEFT">ingestion_status</TD></TR><TR><TD ALIGN="LEFT">audit_status</TD></TR><TR><TD ALIGN="LEFT">audit_at_utc</TD></TR><TR><TD ALIGN="LEFT">metadata_series_count</TD></TR><TR><TD ALIGN="LEFT">normalized_series_count</TD></TR></TABLE>>];
"RawArtifact" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" STYLE="ROUNDED" BGCOLOR="white" COLOR="#1f3557"><TR><TD COLSPAN="1" BGCOLOR="#1f3557" CELLPADDING="5"><FONT COLOR="white" POINT-SIZE="12"><B>:RawArtifact</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><U><B>sha256</B></U></TD></TR><TR><TD ALIGN="LEFT">provider_id</TD></TR><TR><TD ALIGN="LEFT">original_file_name</TD></TR><TR><TD ALIGN="LEFT">raw_file_name</TD></TR><TR><TD ALIGN="LEFT">raw_file_path</TD></TR><TR><TD ALIGN="LEFT">bytes</TD></TR><TR><TD ALIGN="LEFT">storage_class</TD></TR><TR><TD ALIGN="LEFT">registered_at_utc</TD></TR></TABLE>>];
"StagingRun" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" STYLE="ROUNDED" BGCOLOR="white" COLOR="#1f3557"><TR><TD COLSPAN="1" BGCOLOR="#1f3557" CELLPADDING="5"><FONT COLOR="white" POINT-SIZE="12"><B>:StagingRun</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><U><B>staging_key</B></U></TD></TR><TR><TD ALIGN="LEFT">staging_path</TD></TR><TR><TD ALIGN="LEFT">raw_archive_sha256</TD></TR><TR><TD ALIGN="LEFT">normalization_status</TD></TR><TR><TD ALIGN="LEFT">audit_status</TD></TR><TR><TD ALIGN="LEFT">audit_at_utc</TD></TR><TR><TD ALIGN="LEFT">metadata_series_count</TD></TR><TR><TD ALIGN="LEFT">normalized_union_series_count</TD></TR><TR><TD ALIGN="LEFT">weekly_normalized_rows</TD></TR><TR><TD ALIGN="LEFT">ending_wednesday_normalized_rows</TD></TR></TABLE>>];
"SourceMember" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" STYLE="ROUNDED" BGCOLOR="white" COLOR="#1f3557"><TR><TD COLSPAN="1" BGCOLOR="#1f3557" CELLPADDING="5"><FONT COLOR="white" POINT-SIZE="12"><B>:SourceMember</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><U><B>member_key</B></U></TD></TR><TR><TD ALIGN="LEFT">dataset_id</TD></TR><TR><TD ALIGN="LEFT">member_path</TD></TR><TR><TD ALIGN="LEFT">frequency_label</TD></TR><TR><TD ALIGN="LEFT">base_series_count</TD></TR><TR><TD ALIGN="LEFT">data_column_count</TD></TR><TR><TD ALIGN="LEFT">normalized_row_count</TD></TR><TR><TD ALIGN="LEFT">nonmissing_value_count</TD></TR></TABLE>>];
"SeriesVariant" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" STYLE="ROUNDED" BGCOLOR="white" COLOR="#1f3557"><TR><TD COLSPAN="1" BGCOLOR="#1f3557" CELLPADDING="5"><FONT COLOR="white" POINT-SIZE="12"><B>:SeriesVariant</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><U><B>variant_key</B></U></TD></TR><TR><TD ALIGN="LEFT">series_id</TD></TR><TR><TD ALIGN="LEFT">dataset_id</TD></TR><TR><TD ALIGN="LEFT">transformation_code</TD></TR><TR><TD ALIGN="LEFT">frequency_label</TD></TR><TR><TD ALIGN="LEFT">raw_column_name</TD></TR><TR><TD ALIGN="LEFT">source_member_path</TD></TR></TABLE>>];
}
"Series" -> "Release" [label=<<B>:IN_RELEASE</B><BR/><FONT POINT-SIZE="8">from FK fk_series_release</FONT>>, style=solid, constraint=true];
"Series" -> "Frequency" [label=<<B>:HAS_FREQUENCY</B><BR/><FONT POINT-SIZE="8">from FK fk_series_frequency</FONT>>, style=solid, constraint=true];
"Series" -> "Units" [label=<<B>:MEASURED_IN</B><BR/><FONT POINT-SIZE="8">from FK fk_series_units</FONT>>, style=solid, constraint=true];
"Series" -> "SeasonalAdjustment" [label=<<B>:ADJUSTED</B><BR/><FONT POINT-SIZE="8">from FK fk_series_sa</FONT>>, style=solid, constraint=true];
"Series" -> "Category" [label=<<B>:IN_CATEGORY</B><BR/><FONT POINT-SIZE="8">from join table series_category</FONT>>, style=solid, constraint=true];
"Series" -> "Tag" [label=<<B>:TAGGED</B><BR/><FONT POINT-SIZE="8">from join table series_tag</FONT>>, style=solid, constraint=true];
"Release" -> "Source" [label=<<B>:PUBLISHED_BY</B><BR/><FONT POINT-SIZE="8">from join table release_source</FONT>>, style=solid, constraint=true];
"Release" -> "ReleaseDate" [label=<<B>:SCHEDULED_ON</B><BR/><FONT POINT-SIZE="8">from FK fk_release_date_release</FONT><BR/><FONT POINT-SIZE="8"><I>Reversed: owner points to weak entity</I></FONT>>, style=solid, constraint=true];
"ReleaseTableElement" -> "Release" [label=<<B>:LISTED_IN</B><BR/><FONT POINT-SIZE="8">from FK fk_rte_release</FONT>>, style=solid, constraint=true];
"ReleaseTableElement" -> "ReleaseTableElement" [label=<<B>:PART_OF</B><BR/><FONT POINT-SIZE="8">from FK fk_rte_parent</FONT><BR/><FONT POINT-SIZE="8"><I>Unary: child element points to its parent</I></FONT>>, style=solid, constraint=true];
"ReleaseTableElement" -> "Series" [label=<<B>:SHOWS</B><BR/><FONT POINT-SIZE="8"><I>No FK in SQL (series_id is text); edge where the Series node exists</I></FONT>>, style=solid, constraint=true];
"Category" -> "Category" [label=<<B>:CHILD_OF</B><BR/><FONT POINT-SIZE="8">from FK fk_category_parent</FONT>>, style=solid, constraint=true];
"Tag" -> "TagGroup" [label=<<B>:IN_GROUP</B><BR/><FONT POINT-SIZE="8">from FK fk_tag_tag_group</FONT>>, style=solid, constraint=true];
"Document" -> "Release" [label=<<B>:DESCRIBES</B>>, style=dashed, constraint=false];
"Document" -> "Chunk" [label=<<B>:HAS_CHUNK</B>>, style=dashed, constraint=true];
"Provider" -> "CatalogSnapshot" [label=<<B>:EXPOSED_IN</B>>, style=dashed, constraint=true];
"Provider" -> "Dataset" [label=<<B>:PUBLISHED</B>>, style=dashed, constraint=true];
"CatalogSnapshot" -> "Category" [label=<<B>:CONTAINS_CATEGORY</B>>, style=dashed, constraint=false];
"CatalogSnapshot" -> "Series" [label=<<B>:CONTAINS_SERIES</B>>, style=dashed, constraint=false];
"CatalogSnapshot" -> "ApiResponseArtifact" [label=<<B>:RAW_RESPONSE</B>>, style=dashed, constraint=true];
"Dataset" -> "Series" [label=<<B>:CONTAINS_SERIES</B>>, style=dashed, constraint=false];
"Dataset" -> "RawArtifact" [label=<<B>:HAS_RAW_ARTIFACT</B>>, style=dashed, constraint=true];
"Dataset" -> "SourceMember" [label=<<B>:HAS_SOURCE_MEMBER</B>>, style=dashed, constraint=true];
"Dataset" -> "StagingRun" [label=<<B>:HAS_STAGING_RUN</B>>, style=dashed, constraint=true];
"Series" -> "SeriesVariant" [label=<<B>:HAS_TRANSFORMATION</B>>, style=dashed, constraint=false];
"SeriesVariant" -> "SourceMember" [label=<<B>:AVAILABLE_IN</B>>, style=dashed, constraint=true];
legend [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" BGCOLOR="white" COLOR="#1f3557"><TR><TD COLSPAN="2" BGCOLOR="#1f3557"><FONT COLOR="white"><B>Notation</B></FONT></TD></TR><TR><TD ALIGN="LEFT">:Label</TD><TD ALIGN="LEFT">node label (one per entity table)</TD></TR><TR><TD ALIGN="LEFT"><U><B>property</B></U></TD><TD ALIGN="LEFT">business key</TD></TR><TR><TD ALIGN="LEFT">arrow :TYPE</TD><TD ALIGN="LEFT">directed relationship; Neo4j has no cardinality or null markers</TD></TR><TR><TD ALIGN="LEFT">solid / dashed</TD><TD ALIGN="LEFT">catalog relationship / document or lineage relationship</TD></TR><TR><TD COLSPAN="2" BGCOLOR="#1f3557"><FONT COLOR="white"><B>Relational to graph conversion</B></FONT></TD></TR><TR><TD ALIGN="LEFT">table frequency</TD><TD ALIGN="LEFT">:Frequency (node label)</TD></TR><TR><TD ALIGN="LEFT">table units</TD><TD ALIGN="LEFT">:Units (node label)</TD></TR><TR><TD ALIGN="LEFT">table seasonal_adjustment</TD><TD ALIGN="LEFT">:SeasonalAdjustment (node label)</TD></TR><TR><TD ALIGN="LEFT">table source</TD><TD ALIGN="LEFT">:Source (node label)</TD></TR><TR><TD ALIGN="LEFT">table release</TD><TD ALIGN="LEFT">:Release (node label)</TD></TR><TR><TD ALIGN="LEFT">table release_source</TD><TD ALIGN="LEFT">:PUBLISHED_BY (join table became a relationship)</TD></TR><TR><TD ALIGN="LEFT">table release_date</TD><TD ALIGN="LEFT">:ReleaseDate (node label)</TD></TR><TR><TD ALIGN="LEFT">table release_table_element</TD><TD ALIGN="LEFT">:ReleaseTableElement (node label)</TD></TR><TR><TD ALIGN="LEFT">table category</TD><TD ALIGN="LEFT">:Category (node label)</TD></TR><TR><TD ALIGN="LEFT">table tag_group</TD><TD ALIGN="LEFT">:TagGroup (node label)</TD></TR><TR><TD ALIGN="LEFT">table tag</TD><TD ALIGN="LEFT">:Tag (node label)</TD></TR><TR><TD ALIGN="LEFT">table series</TD><TD ALIGN="LEFT">:Series (node label)</TD></TR><TR><TD ALIGN="LEFT">table series_category</TD><TD ALIGN="LEFT">:IN_CATEGORY (join table became a relationship)</TD></TR><TR><TD ALIGN="LEFT">table series_tag</TD><TD ALIGN="LEFT">:TAGGED (join table became a relationship)</TD></TR><TR><TD ALIGN="LEFT">table observation</TD><TD ALIGN="LEFT">not in graph: Dense vintages stay in SQL; the graph holds the catalog and lineage</TD></TR><TR><TD ALIGN="LEFT">table vintage_date</TD><TD ALIGN="LEFT">not in graph: A series' revision timeline is dense and range-queried, like its vintages; stays in SQL</TD></TR><TR><TD ALIGN="LEFT">fk_release_date_release</TD><TD ALIGN="LEFT">:SCHEDULED_ON (Release to ReleaseDate)</TD></TR><TR><TD ALIGN="LEFT">fk_rte_release</TD><TD ALIGN="LEFT">:LISTED_IN (ReleaseTableElement to Release)</TD></TR><TR><TD ALIGN="LEFT">fk_rte_parent</TD><TD ALIGN="LEFT">:PART_OF (ReleaseTableElement to ReleaseTableElement)</TD></TR><TR><TD ALIGN="LEFT">fk_category_parent</TD><TD ALIGN="LEFT">:CHILD_OF (Category to Category)</TD></TR><TR><TD ALIGN="LEFT">fk_tag_tag_group</TD><TD ALIGN="LEFT">:IN_GROUP (Tag to TagGroup)</TD></TR><TR><TD ALIGN="LEFT">fk_series_release</TD><TD ALIGN="LEFT">:IN_RELEASE (Series to Release)</TD></TR><TR><TD ALIGN="LEFT">fk_series_frequency</TD><TD ALIGN="LEFT">:HAS_FREQUENCY (Series to Frequency)</TD></TR><TR><TD ALIGN="LEFT">fk_series_units</TD><TD ALIGN="LEFT">:MEASURED_IN (Series to Units)</TD></TR><TR><TD ALIGN="LEFT">fk_series_sa</TD><TD ALIGN="LEFT">:ADJUSTED (Series to SeasonalAdjustment)</TD></TR></TABLE>>];
}
