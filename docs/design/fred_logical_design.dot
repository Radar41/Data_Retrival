digraph logical {
graph [rankdir=LR, splines=spline, nodesep=0.45, ranksep=1.2, pad=0.4, fontname="Helvetica", labelloc=t, fontsize=20, label=<<B>FRED Metadata Catalog: Logical Design (relational model, DBMS-independent)</B><BR/><FONT POINT-SIZE="11">Adrian Aziza · ADIT2200-01 Database Management, Fall 2026</FONT>>];
node [shape=plaintext, fontname="Helvetica", fontsize=10];
edge [dir=both, color="#1f3557", fontname="Helvetica", fontsize=9, arrowsize=0.9, fontcolor="#333333"];
"frequency" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#1f3557"><TR><TD COLSPAN="1" BGCOLOR="#1f3557" CELLPADDING="5"><FONT COLOR="white" POINT-SIZE="12"><B>FREQUENCY</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="frequency_code"><U>frequency_code</U></TD></TR><TR><TD ALIGN="LEFT" PORT="frequency_name">frequency_name</TD></TR></TABLE>>];
"units" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#1f3557"><TR><TD COLSPAN="1" BGCOLOR="#1f3557" CELLPADDING="5"><FONT COLOR="white" POINT-SIZE="12"><B>UNITS</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="units_code"><U>units_code</U></TD></TR><TR><TD ALIGN="LEFT" PORT="units_name">units_name</TD></TR></TABLE>>];
"seasonal_adjustment" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#1f3557"><TR><TD COLSPAN="1" BGCOLOR="#1f3557" CELLPADDING="5"><FONT COLOR="white" POINT-SIZE="12"><B>SEASONAL_ADJUSTMENT</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="sa_code"><U>sa_code</U></TD></TR><TR><TD ALIGN="LEFT" PORT="sa_name">sa_name</TD></TR></TABLE>>];
"source" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#1f3557"><TR><TD COLSPAN="1" BGCOLOR="#1f3557" CELLPADDING="5"><FONT COLOR="white" POINT-SIZE="12"><B>SOURCE</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="source_id"><U>source_id</U></TD></TR><TR><TD ALIGN="LEFT" PORT="source_name">source_name</TD></TR><TR><TD ALIGN="LEFT" PORT="source_link">source_link</TD></TR></TABLE>>];
"release" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#1f3557"><TR><TD COLSPAN="1" BGCOLOR="#1f3557" CELLPADDING="5"><FONT COLOR="white" POINT-SIZE="12"><B>RELEASE</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="release_id"><U>release_id</U></TD></TR><TR><TD ALIGN="LEFT" PORT="release_name">release_name</TD></TR><TR><TD ALIGN="LEFT" PORT="press_release">press_release</TD></TR><TR><TD ALIGN="LEFT" PORT="release_link">release_link</TD></TR></TABLE>>];
"release_source" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" STYLE="ROUNDED" COLOR="#1f3557"><TR><TD COLSPAN="1" BGCOLOR="#1f3557" CELLPADDING="5"><FONT COLOR="white" POINT-SIZE="12"><B>RELEASE_SOURCE</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="8"><I>associative entity</I></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="release_id"><U><I>release_id</I> (FK)</U></TD></TR><TR><TD ALIGN="LEFT" PORT="source_id"><U><I>source_id</I> (FK)</U></TD></TR></TABLE>>];
"release_date" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="2" COLOR="#1f3557"><TR><TD><TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#1f3557"><TR><TD COLSPAN="1" BGCOLOR="#1f3557" CELLPADDING="5"><FONT COLOR="white" POINT-SIZE="12"><B>RELEASE_DATE</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="8"><I>weak entity</I></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="release_id"><U><I>release_id</I> (FK)</U></TD></TR><TR><TD ALIGN="LEFT" PORT="release_date"><U>release_date</U></TD></TR><TR><TD ALIGN="LEFT" PORT="date_status">date_status</TD></TR></TABLE></TD></TR></TABLE>>];
"release_table_element" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#1f3557"><TR><TD COLSPAN="1" BGCOLOR="#1f3557" CELLPADDING="5"><FONT COLOR="white" POINT-SIZE="12"><B>RELEASE_TABLE_ELEMENT</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="element_id"><U>element_id</U></TD></TR><TR><TD ALIGN="LEFT" PORT="release_id"><I>release_id</I> (FK)</TD></TR><TR><TD ALIGN="LEFT" PORT="parent_id"><I>parent_id</I> (FK)</TD></TR><TR><TD ALIGN="LEFT" PORT="element_type">element_type</TD></TR><TR><TD ALIGN="LEFT" PORT="element_name">element_name</TD></TR><TR><TD ALIGN="LEFT" PORT="element_level">element_level</TD></TR><TR><TD ALIGN="LEFT" PORT="line_no">line_no</TD></TR><TR><TD ALIGN="LEFT" PORT="series_id">series_id</TD></TR></TABLE>>];
"category" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#1f3557"><TR><TD COLSPAN="1" BGCOLOR="#1f3557" CELLPADDING="5"><FONT COLOR="white" POINT-SIZE="12"><B>CATEGORY</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="category_id"><U>category_id</U></TD></TR><TR><TD ALIGN="LEFT" PORT="category_name">category_name</TD></TR><TR><TD ALIGN="LEFT" PORT="parent_id"><I>parent_id</I> (FK)</TD></TR></TABLE>>];
"tag_group" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#1f3557"><TR><TD COLSPAN="1" BGCOLOR="#1f3557" CELLPADDING="5"><FONT COLOR="white" POINT-SIZE="12"><B>TAG_GROUP</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="group_id"><U>group_id</U></TD></TR><TR><TD ALIGN="LEFT" PORT="group_name">group_name</TD></TR></TABLE>>];
"tag" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#1f3557"><TR><TD COLSPAN="1" BGCOLOR="#1f3557" CELLPADDING="5"><FONT COLOR="white" POINT-SIZE="12"><B>TAG</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="tag_name"><U>tag_name</U></TD></TR><TR><TD ALIGN="LEFT" PORT="group_id"><I>group_id</I> (FK)</TD></TR><TR><TD ALIGN="LEFT" PORT="tag_notes">tag_notes</TD></TR><TR><TD ALIGN="LEFT" PORT="popularity">popularity</TD></TR></TABLE>>];
"series" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#1f3557"><TR><TD COLSPAN="1" BGCOLOR="#1f3557" CELLPADDING="5"><FONT COLOR="white" POINT-SIZE="12"><B>SERIES</B></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="series_id"><U>series_id</U></TD></TR><TR><TD ALIGN="LEFT" PORT="title">title</TD></TR><TR><TD ALIGN="LEFT" PORT="release_id"><I>release_id</I> (FK)</TD></TR><TR><TD ALIGN="LEFT" PORT="frequency_code"><I>frequency_code</I> (FK)</TD></TR><TR><TD ALIGN="LEFT" PORT="units_code"><I>units_code</I> (FK)</TD></TR><TR><TD ALIGN="LEFT" PORT="sa_code"><I>sa_code</I> (FK)</TD></TR><TR><TD ALIGN="LEFT" PORT="observation_start">[observation_start]</TD></TR><TR><TD ALIGN="LEFT" PORT="observation_end">[observation_end]</TD></TR><TR><TD ALIGN="LEFT" PORT="last_updated">last_updated</TD></TR><TR><TD ALIGN="LEFT" PORT="popularity">popularity</TD></TR><TR><TD ALIGN="LEFT" PORT="notes">notes</TD></TR></TABLE>>];
"series_category" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" STYLE="ROUNDED" COLOR="#1f3557"><TR><TD COLSPAN="1" BGCOLOR="#1f3557" CELLPADDING="5"><FONT COLOR="white" POINT-SIZE="12"><B>SERIES_CATEGORY</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="8"><I>associative entity</I></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="series_id"><U><I>series_id</I> (FK)</U></TD></TR><TR><TD ALIGN="LEFT" PORT="category_id"><U><I>category_id</I> (FK)</U></TD></TR></TABLE>>];
"series_tag" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" STYLE="ROUNDED" COLOR="#1f3557"><TR><TD COLSPAN="1" BGCOLOR="#1f3557" CELLPADDING="5"><FONT COLOR="white" POINT-SIZE="12"><B>SERIES_TAG</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="8"><I>associative entity</I></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="series_id"><U><I>series_id</I> (FK)</U></TD></TR><TR><TD ALIGN="LEFT" PORT="tag_name"><U><I>tag_name</I> (FK)</U></TD></TR></TABLE>>];
"observation" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="2" COLOR="#1f3557"><TR><TD><TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#1f3557"><TR><TD COLSPAN="1" BGCOLOR="#1f3557" CELLPADDING="5"><FONT COLOR="white" POINT-SIZE="12"><B>OBSERVATION</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="8"><I>weak entity</I></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="series_id"><U><I>series_id</I> (FK)</U></TD></TR><TR><TD ALIGN="LEFT" PORT="observation_date"><U>observation_date</U></TD></TR><TR><TD ALIGN="LEFT" PORT="realtime_start"><U>realtime_start</U></TD></TR><TR><TD ALIGN="LEFT" PORT="realtime_end">realtime_end</TD></TR><TR><TD ALIGN="LEFT" PORT="value">value</TD></TR></TABLE></TD></TR></TABLE>>];
"vintage_date" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="2" COLOR="#1f3557"><TR><TD><TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#1f3557"><TR><TD COLSPAN="1" BGCOLOR="#1f3557" CELLPADDING="5"><FONT COLOR="white" POINT-SIZE="12"><B>VINTAGE_DATE</B></FONT></TD></TR><TR><TD><FONT POINT-SIZE="8"><I>weak entity</I></FONT></TD></TR><TR><TD ALIGN="LEFT" PORT="series_id"><U><I>series_id</I> (FK)</U></TD></TR><TR><TD ALIGN="LEFT" PORT="vintage_date"><U>vintage_date</U></TD></TR></TABLE></TD></TR></TABLE>>];
"release":"release_id":e -> "release_source":"release_id":w [arrowtail=teetee, arrowhead=crowtee, style=solid, penwidth=1.6, label=<published by>];
"source":"source_id":e -> "release_source":"source_id":w [arrowtail=teetee, arrowhead=crowtee, style=solid, penwidth=1.6, label=<publishes>];
"release":"release_id":e -> "release_date":"release_id":w [arrowtail=teetee, arrowhead=crowtee, style=solid, penwidth=1.6, label=<is scheduled>];
"release":"release_id":e -> "release_table_element":"release_id":w [arrowtail=teetee, arrowhead=crowodot, style=dashed, penwidth=1.1, label=<structures>];
"release_table_element":"element_id":e -> "release_table_element":"parent_id":w [arrowtail=teeodot, arrowhead=crowodot, style=dashed, penwidth=1.1, label=<contains>];
"category":"category_id":e -> "category":"parent_id":w [arrowtail=teeodot, arrowhead=crowodot, style=dashed, penwidth=1.1, label=<parent of>];
"tag_group":"group_id":e -> "tag":"group_id":w [arrowtail=teetee, arrowhead=crowtee, style=dashed, penwidth=1.1, label=<groups>];
"release":"release_id":e -> "series":"release_id":w [arrowtail=teetee, arrowhead=crowtee, style=dashed, penwidth=1.1, label=<contains>];
"frequency":"frequency_code":e -> "series":"frequency_code":w [arrowtail=teetee, arrowhead=crowodot, style=dashed, penwidth=1.1, label=<describes>];
"units":"units_code":e -> "series":"units_code":w [arrowtail=teetee, arrowhead=crowodot, style=dashed, penwidth=1.1, label=<measures>];
"seasonal_adjustment":"sa_code":e -> "series":"sa_code":w [arrowtail=teetee, arrowhead=crowodot, style=dashed, penwidth=1.1, label=<adjusts>];
"series":"series_id":e -> "series_category":"series_id":w [arrowtail=teetee, arrowhead=crowtee, style=solid, penwidth=1.6, label=<classified in>];
"category":"category_id":e -> "series_category":"category_id":w [arrowtail=teetee, arrowhead=crowodot, style=solid, penwidth=1.6, label=<holds>];
"series":"series_id":e -> "series_tag":"series_id":w [arrowtail=teetee, arrowhead=crowodot, style=solid, penwidth=1.6, label=<carries>];
"tag":"tag_name":e -> "series_tag":"tag_name":w [arrowtail=teetee, arrowhead=crowtee, style=solid, penwidth=1.6, label=<applied as>];
"series":"series_id":e -> "observation":"series_id":w [arrowtail=teetee, arrowhead=crowodot, style=solid, penwidth=1.6, label=<has>];
"series":"series_id":e -> "vintage_date":"series_id":w [arrowtail=teetee, arrowhead=crowodot, style=solid, penwidth=1.6, label=<revised on>];
{rank=same; frequency; units; seasonal_adjustment;}
{rank=same; tag_group; source;}
legend [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#1f3557"><TR><TD COLSPAN="2" BGCOLOR="#1f3557"><FONT COLOR="white"><B>Notation</B></FONT></TD></TR><TR><TD ALIGN="LEFT">solid line</TD><TD ALIGN="LEFT">identifying (FK is part of the PK)</TD></TR><TR><TD ALIGN="LEFT">dashed line</TD><TD ALIGN="LEFT">non-identifying</TD></TR><TR><TD ALIGN="LEFT">|| and crow's foot</TD><TD ALIGN="LEFT">exactly one / many; a circle means zero is allowed</TD></TR><TR><TD ALIGN="LEFT"><U>underlined</U></TD><TD ALIGN="LEFT">primary key</TD></TR><TR><TD ALIGN="LEFT"><I>italic</I> (FK)</TD><TD ALIGN="LEFT">foreign key</TD></TR><TR><TD ALIGN="LEFT">[brackets]</TD><TD ALIGN="LEFT">derived attribute (controlled denormalization)</TD></TR><TR><TD ALIGN="LEFT">double border</TD><TD ALIGN="LEFT">weak entity</TD></TR><TR><TD ALIGN="LEFT">rounded border</TD><TD ALIGN="LEFT">associative entity</TD></TR></TABLE>>];
}
