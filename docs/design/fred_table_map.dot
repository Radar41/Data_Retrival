digraph table_map {
graph [rankdir=LR, pad=0.4, fontname="Helvetica", labelloc=t, fontsize=20, label=<<B>FRED Metadata Catalog: Table map: underline = primary key, FK = foreign key, arrows point to the referenced key</B><BR/><FONT POINT-SIZE="11">Adrian Aziza · ADIT2200-01 Database Management, Fall 2026</FONT>>, nodesep=0.35, ranksep=0.9, splines=true];
node [fontname="Helvetica", fontsize=10, shape=plain];
edge [color="#8a1c22", arrowsize=0.7, penwidth=1.1];
"FREQUENCY" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#1f3557"><TR><TD BGCOLOR="#1f3557" COLSPAN="2"><FONT COLOR="white"><B>FREQUENCY</B></FONT></TD></TR><TR><TD PORT="frequency_code" ALIGN="LEFT"><U>frequency_code</U></TD><TD>PK</TD></TR><TR><TD PORT="frequency_name" ALIGN="LEFT">frequency_name</TD><TD></TD></TR></TABLE>>];
"UNITS" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#1f3557"><TR><TD BGCOLOR="#1f3557" COLSPAN="2"><FONT COLOR="white"><B>UNITS</B></FONT></TD></TR><TR><TD PORT="units_code" ALIGN="LEFT"><U>units_code</U></TD><TD>PK</TD></TR><TR><TD PORT="units_name" ALIGN="LEFT">units_name</TD><TD></TD></TR></TABLE>>];
"SEASONAL_ADJUSTMENT" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#1f3557"><TR><TD BGCOLOR="#1f3557" COLSPAN="2"><FONT COLOR="white"><B>SEASONAL_ADJUSTMENT</B></FONT></TD></TR><TR><TD PORT="sa_code" ALIGN="LEFT"><U>sa_code</U></TD><TD>PK</TD></TR><TR><TD PORT="sa_name" ALIGN="LEFT">sa_name</TD><TD></TD></TR></TABLE>>];
"SOURCE" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#1f3557"><TR><TD BGCOLOR="#1f3557" COLSPAN="2"><FONT COLOR="white"><B>SOURCE</B></FONT></TD></TR><TR><TD PORT="source_id" ALIGN="LEFT"><U>source_id</U></TD><TD>PK</TD></TR><TR><TD PORT="source_name" ALIGN="LEFT">source_name</TD><TD></TD></TR><TR><TD PORT="source_link" ALIGN="LEFT">source_link</TD><TD></TD></TR></TABLE>>];
"RELEASE" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#1f3557"><TR><TD BGCOLOR="#1f3557" COLSPAN="2"><FONT COLOR="white"><B>RELEASE</B></FONT></TD></TR><TR><TD PORT="release_id" ALIGN="LEFT"><U>release_id</U></TD><TD>PK</TD></TR><TR><TD PORT="release_name" ALIGN="LEFT">release_name</TD><TD></TD></TR><TR><TD PORT="press_release" ALIGN="LEFT">press_release</TD><TD></TD></TR><TR><TD PORT="release_link" ALIGN="LEFT">release_link</TD><TD></TD></TR></TABLE>>];
"RELEASE_SOURCE" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#1f3557"><TR><TD BGCOLOR="#1f3557" COLSPAN="2"><FONT COLOR="white"><B>RELEASE_SOURCE</B></FONT></TD></TR><TR><TD PORT="release_id" ALIGN="LEFT"><U>release_id</U></TD><TD>FK</TD></TR><TR><TD PORT="source_id" ALIGN="LEFT"><U>source_id</U></TD><TD>FK</TD></TR></TABLE>>];
"RELEASE_DATE" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#1f3557"><TR><TD BGCOLOR="#1f3557" COLSPAN="2"><FONT COLOR="white"><B>RELEASE_DATE</B></FONT></TD></TR><TR><TD PORT="release_id" ALIGN="LEFT"><U>release_id</U></TD><TD>FK</TD></TR><TR><TD PORT="release_date" ALIGN="LEFT"><U>release_date</U></TD><TD>PK</TD></TR><TR><TD PORT="date_status" ALIGN="LEFT">date_status</TD><TD></TD></TR></TABLE>>];
"CATEGORY" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#1f3557"><TR><TD BGCOLOR="#1f3557" COLSPAN="2"><FONT COLOR="white"><B>CATEGORY</B></FONT></TD></TR><TR><TD PORT="category_id" ALIGN="LEFT"><U>category_id</U></TD><TD>PK</TD></TR><TR><TD PORT="category_name" ALIGN="LEFT">category_name</TD><TD></TD></TR><TR><TD PORT="parent_id" ALIGN="LEFT">parent_id</TD><TD>FK</TD></TR></TABLE>>];
"TAG_GROUP" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#1f3557"><TR><TD BGCOLOR="#1f3557" COLSPAN="2"><FONT COLOR="white"><B>TAG_GROUP</B></FONT></TD></TR><TR><TD PORT="group_id" ALIGN="LEFT"><U>group_id</U></TD><TD>PK</TD></TR><TR><TD PORT="group_name" ALIGN="LEFT">group_name</TD><TD></TD></TR></TABLE>>];
"TAG" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#1f3557"><TR><TD BGCOLOR="#1f3557" COLSPAN="2"><FONT COLOR="white"><B>TAG</B></FONT></TD></TR><TR><TD PORT="tag_name" ALIGN="LEFT"><U>tag_name</U></TD><TD>PK</TD></TR><TR><TD PORT="group_id" ALIGN="LEFT">group_id</TD><TD>FK</TD></TR><TR><TD PORT="tag_notes" ALIGN="LEFT">tag_notes</TD><TD></TD></TR><TR><TD PORT="popularity" ALIGN="LEFT">popularity</TD><TD></TD></TR></TABLE>>];
"SERIES" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#1f3557"><TR><TD BGCOLOR="#1f3557" COLSPAN="2"><FONT COLOR="white"><B>SERIES</B></FONT></TD></TR><TR><TD PORT="series_id" ALIGN="LEFT"><U>series_id</U></TD><TD>PK</TD></TR><TR><TD PORT="title" ALIGN="LEFT">title</TD><TD></TD></TR><TR><TD PORT="release_id" ALIGN="LEFT">release_id</TD><TD>FK</TD></TR><TR><TD PORT="frequency_code" ALIGN="LEFT">frequency_code</TD><TD>FK</TD></TR><TR><TD PORT="units_code" ALIGN="LEFT">units_code</TD><TD>FK</TD></TR><TR><TD PORT="sa_code" ALIGN="LEFT">sa_code</TD><TD>FK</TD></TR><TR><TD PORT="observation_start" ALIGN="LEFT">[observation_start]</TD><TD></TD></TR><TR><TD PORT="observation_end" ALIGN="LEFT">[observation_end]</TD><TD></TD></TR><TR><TD PORT="last_updated" ALIGN="LEFT">last_updated</TD><TD></TD></TR><TR><TD PORT="popularity" ALIGN="LEFT">popularity</TD><TD></TD></TR><TR><TD PORT="notes" ALIGN="LEFT">notes</TD><TD></TD></TR></TABLE>>];
"SERIES_CATEGORY" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#1f3557"><TR><TD BGCOLOR="#1f3557" COLSPAN="2"><FONT COLOR="white"><B>SERIES_CATEGORY</B></FONT></TD></TR><TR><TD PORT="series_id" ALIGN="LEFT"><U>series_id</U></TD><TD>FK</TD></TR><TR><TD PORT="category_id" ALIGN="LEFT"><U>category_id</U></TD><TD>FK</TD></TR></TABLE>>];
"SERIES_TAG" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#1f3557"><TR><TD BGCOLOR="#1f3557" COLSPAN="2"><FONT COLOR="white"><B>SERIES_TAG</B></FONT></TD></TR><TR><TD PORT="series_id" ALIGN="LEFT"><U>series_id</U></TD><TD>FK</TD></TR><TR><TD PORT="tag_name" ALIGN="LEFT"><U>tag_name</U></TD><TD>FK</TD></TR></TABLE>>];
"OBSERVATION" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#1f3557"><TR><TD BGCOLOR="#1f3557" COLSPAN="2"><FONT COLOR="white"><B>OBSERVATION</B></FONT></TD></TR><TR><TD PORT="series_id" ALIGN="LEFT"><U>series_id</U></TD><TD>FK</TD></TR><TR><TD PORT="observation_date" ALIGN="LEFT"><U>observation_date</U></TD><TD>PK</TD></TR><TR><TD PORT="realtime_start" ALIGN="LEFT"><U>realtime_start</U></TD><TD>PK</TD></TR><TR><TD PORT="realtime_end" ALIGN="LEFT">realtime_end</TD><TD></TD></TR><TR><TD PORT="value" ALIGN="LEFT">value</TD><TD></TD></TR></TABLE>>];
"RELEASE_SOURCE":"release_id":e -> "RELEASE":"release_id":w;
"RELEASE_SOURCE":"source_id":e -> "SOURCE":"source_id":w;
"RELEASE_DATE":"release_id":e -> "RELEASE":"release_id":w;
"CATEGORY":"parent_id":e -> "CATEGORY":"category_id":w;
"TAG":"group_id":e -> "TAG_GROUP":"group_id":w;
"SERIES":"release_id":e -> "RELEASE":"release_id":w;
"SERIES":"frequency_code":e -> "FREQUENCY":"frequency_code":w;
"SERIES":"units_code":e -> "UNITS":"units_code":w;
"SERIES":"sa_code":e -> "SEASONAL_ADJUSTMENT":"sa_code":w;
"SERIES_CATEGORY":"series_id":e -> "SERIES":"series_id":w;
"SERIES_CATEGORY":"category_id":e -> "CATEGORY":"category_id":w;
"SERIES_TAG":"series_id":e -> "SERIES":"series_id":w;
"SERIES_TAG":"tag_name":e -> "TAG":"tag_name":w;
"OBSERVATION":"series_id":e -> "SERIES":"series_id":w;
{rank=same; FREQUENCY; UNITS; SEASONAL_ADJUSTMENT;}
}
