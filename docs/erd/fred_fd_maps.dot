digraph FD {
graph [rankdir=LR, fontname="Helvetica", labelloc=t, fontsize=18, label="Functional dependency maps (all relations in 3NF: every determinant is the whole primary key)", nodesep=0.25, ranksep=0.5, compound=true];
node [fontname="Helvetica", fontsize=10, shape=box, style="rounded,filled", fillcolor="white", color="#1f3557"];
edge [color="#1f3557", arrowsize=0.7];
subgraph cluster_0 { label="FREQUENCY"; style="rounded"; color="#1f3557"; fontname="Helvetica-Bold"; fontsize=11;
k0 [label=<<U>frequency_code</U>>, fillcolor="#e8eef7"];
a0_0 [label="frequency_name", fillcolor="white"];
k0 -> a0_0;
}
subgraph cluster_1 { label="UNITS"; style="rounded"; color="#1f3557"; fontname="Helvetica-Bold"; fontsize=11;
k1 [label=<<U>units_code</U>>, fillcolor="#e8eef7"];
a1_0 [label="units_name", fillcolor="white"];
k1 -> a1_0;
}
subgraph cluster_2 { label="SEASONAL_ADJUSTMENT"; style="rounded"; color="#1f3557"; fontname="Helvetica-Bold"; fontsize=11;
k2 [label=<<U>sa_code</U>>, fillcolor="#e8eef7"];
a2_0 [label="sa_name", fillcolor="white"];
k2 -> a2_0;
}
subgraph cluster_3 { label="SOURCE"; style="rounded"; color="#1f3557"; fontname="Helvetica-Bold"; fontsize=11;
k3 [label=<<U>source_id</U>>, fillcolor="#e8eef7"];
a3_0 [label="source_name", fillcolor="white"];
k3 -> a3_0;
a3_1 [label="source_link", fillcolor="white"];
k3 -> a3_1;
}
subgraph cluster_4 { label="RELEASE"; style="rounded"; color="#1f3557"; fontname="Helvetica-Bold"; fontsize=11;
k4 [label=<<U>release_id</U>>, fillcolor="#e8eef7"];
a4_0 [label="release_name", fillcolor="white"];
k4 -> a4_0;
a4_1 [label="press_release", fillcolor="white"];
k4 -> a4_1;
a4_2 [label="release_link", fillcolor="white"];
k4 -> a4_2;
}
subgraph cluster_5 { label="RELEASE_DATE"; style="rounded"; color="#1f3557"; fontname="Helvetica-Bold"; fontsize=11;
k5 [label=<<U>release_id<BR/>release_date</U>>, fillcolor="#e8eef7"];
a5_0 [label="date_status", fillcolor="white"];
k5 -> a5_0;
}
subgraph cluster_6 { label="CATEGORY"; style="rounded"; color="#1f3557"; fontname="Helvetica-Bold"; fontsize=11;
k6 [label=<<U>category_id</U>>, fillcolor="#e8eef7"];
a6_0 [label="category_name", fillcolor="white"];
k6 -> a6_0;
a6_1 [label="parent_id (FK)", fillcolor="white"];
k6 -> a6_1;
}
subgraph cluster_7 { label="TAG_GROUP"; style="rounded"; color="#1f3557"; fontname="Helvetica-Bold"; fontsize=11;
k7 [label=<<U>group_id</U>>, fillcolor="#e8eef7"];
a7_0 [label="group_name", fillcolor="white"];
k7 -> a7_0;
}
subgraph cluster_8 { label="TAG"; style="rounded"; color="#1f3557"; fontname="Helvetica-Bold"; fontsize=11;
k8 [label=<<U>tag_name</U>>, fillcolor="#e8eef7"];
a8_0 [label="group_id (FK)", fillcolor="white"];
k8 -> a8_0;
a8_1 [label="tag_notes", fillcolor="white"];
k8 -> a8_1;
a8_2 [label="popularity", fillcolor="white"];
k8 -> a8_2;
}
subgraph cluster_9 { label="SERIES"; style="rounded"; color="#1f3557"; fontname="Helvetica-Bold"; fontsize=11;
k9 [label=<<U>series_id</U>>, fillcolor="#e8eef7"];
a9_0 [label="title", fillcolor="white"];
k9 -> a9_0;
a9_1 [label="release_id (FK)", fillcolor="white"];
k9 -> a9_1;
a9_2 [label="frequency_code (FK)", fillcolor="white"];
k9 -> a9_2;
a9_3 [label="units_code (FK)", fillcolor="white"];
k9 -> a9_3;
a9_4 [label="sa_code (FK)", fillcolor="white"];
k9 -> a9_4;
a9_5 [label="[observation_start]", fillcolor="#fbefdc"];
k9 -> a9_5;
a9_6 [label="[observation_end]", fillcolor="#fbefdc"];
k9 -> a9_6;
a9_7 [label="last_updated", fillcolor="white"];
k9 -> a9_7;
a9_8 [label="popularity", fillcolor="white"];
k9 -> a9_8;
a9_9 [label="notes", fillcolor="white"];
k9 -> a9_9;
}
subgraph cluster_10 { label="OBSERVATION"; style="rounded"; color="#1f3557"; fontname="Helvetica-Bold"; fontsize=11;
k10 [label=<<U>series_id<BR/>observation_date<BR/>realtime_start</U>>, fillcolor="#e8eef7"];
a10_0 [label="realtime_end", fillcolor="white"];
k10 -> a10_0;
a10_1 [label="value", fillcolor="white"];
k10 -> a10_1;
}
note [shape=note, fillcolor="#f8f0dc", label="All-key relations (no non-key attributes, nothing to depend):\nRELEASE_SOURCE, SERIES_CATEGORY, SERIES_TAG\n\nDerived attributes in [brackets] are kept as controlled denormalization\nand maintained by trigger (fred_triggers.sql)."];
}