digraph GS {
graph [rankdir=LR, fontname="Helvetica", labelloc=t, fontsize=18, label="Neo4j graph schema: node label {key property}, relationship types. Associative tables and foreign keys from the table map become relationship types here.", nodesep=0.4, ranksep=0.8];
node [fontname="Helvetica", fontsize=10, shape=ellipse, style=filled, fillcolor="#e3f2e9", color="#2f7a4f"];
edge [fontname="Helvetica", fontsize=9, color="#2f7a4f", arrowsize=0.7];
"Provider" [label=<<B>:Provider</B><BR/><FONT POINT-SIZE="8">{provider_id}</FONT>>, fillcolor="#e8eef7"];
"CatalogSnapshot" [label=<<B>:CatalogSnapshot</B><BR/><FONT POINT-SIZE="8">{snapshot_id}</FONT>>, fillcolor="#e8eef7"];
"Source" [label=<<B>:Source</B><BR/><FONT POINT-SIZE="8">{source_key}</FONT>>, fillcolor="#e3f2e9"];
"Release" [label=<<B>:Release</B><BR/><FONT POINT-SIZE="8">{release_key}</FONT>>, fillcolor="#e3f2e9"];
"ReleaseDate" [label=<<B>:ReleaseDate</B><BR/><FONT POINT-SIZE="8">{rd_key}</FONT>>, fillcolor="#e3f2e9"];
"Series" [label=<<B>:Series</B><BR/><FONT POINT-SIZE="8">{catalog_key}</FONT>>, fillcolor="#e3f2e9"];
"Frequency" [label=<<B>:Frequency</B><BR/><FONT POINT-SIZE="8">{code}</FONT>>, fillcolor="#e3f2e9"];
"Units" [label=<<B>:Units</B><BR/><FONT POINT-SIZE="8">{code}</FONT>>, fillcolor="#e3f2e9"];
"SeasonalAdjustment" [label=<<B>:SeasonalAdjustment</B><BR/><FONT POINT-SIZE="8">{code}</FONT>>, fillcolor="#e3f2e9"];
"Category" [label=<<B>:Category</B><BR/><FONT POINT-SIZE="8">{(provider_id, category_id)}</FONT>>, fillcolor="#e3f2e9"];
"Tag" [label=<<B>:Tag</B><BR/><FONT POINT-SIZE="8">{tag_name}</FONT>>, fillcolor="#e3f2e9"];
"TagGroup" [label=<<B>:TagGroup</B><BR/><FONT POINT-SIZE="8">{group_id}</FONT>>, fillcolor="#e3f2e9"];
"Document" [label=<<B>:Document</B><BR/><FONT POINT-SIZE="8">{doc_id}</FONT>>, fillcolor="#fbefdc"];
"Chunk" [label=<<B>:Chunk</B><BR/><FONT POINT-SIZE="8">{chunk_key}</FONT>>, fillcolor="#fbefdc"];
"Provider" -> "CatalogSnapshot" [label=":EXPOSED_IN"];
"CatalogSnapshot" -> "Series" [label=":CONTAINS_SERIES"];
"CatalogSnapshot" -> "Category" [label=":CONTAINS_CATEGORY"];
"Release" -> "Source" [label=":PUBLISHED_BY"];
"Release" -> "ReleaseDate" [label=":SCHEDULED_ON"];
"Series" -> "Release" [label=":IN_RELEASE"];
"Series" -> "Frequency" [label=":HAS_FREQUENCY"];
"Series" -> "Units" [label=":MEASURED_IN"];
"Series" -> "SeasonalAdjustment" [label=":ADJUSTED"];
"Series" -> "Category" [label=":IN_CATEGORY"];
"Category" -> "Category" [label=":CHILD_OF"];
"Series" -> "Tag" [label=":TAGGED"];
"Tag" -> "TagGroup" [label=":IN_GROUP"];
"Document" -> "Release" [label=":DESCRIBES"];
"Document" -> "Chunk" [label=":HAS_CHUNK"];
note [shape=note, fillcolor="#f8f0dc", fontsize=9, label="Not in the graph by design:\nOBSERVATION vintages (PostgreSQL only)\n\nIndexes: fulltext chunk_text on Chunk.text,\nvector chunk_embedding on Chunk.embedding (768, cosine)"];
}